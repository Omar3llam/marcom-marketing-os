{
  "_comment": "MARCOM Design Token Source of Truth — Motion",
  "_version": "1.0.0",
  "_principles": [
    "Slower = more expensive. Fast = cheap.",
    "Entrance: 320–400ms ease-out",
    "Loops (live system): 1.8s–3s subtle",
    "Never > 600ms for one-time transitions",
    "All animations must respect prefers-reduced-motion"
  ],

  "duration": {
    "instant":    "100ms",
    "fast":       "150ms",
    "base":       "200ms",
    "enter":      "320ms",
    "deliberate": "400ms",
    "fill":       "600ms"
  },

  "easing": {
    "out":         "ease-out",
    "spring":      "cubic-bezier(0.16,1,0.3,1)",
    "progress":    "cubic-bezier(0.65,0.05,0.36,1)",
    "linear":      "linear"
  },

  "animations": {
    "fade-in":         "fadeIn 150ms ease-out",
    "scale-in":        "scaleIn 200ms cubic-bezier(0.16,1,0.3,1)",
    "slide-up":        "slideUp 200ms cubic-bezier(0.16,1,0.3,1)",
    "slide-right":     "slideRight 200ms cubic-bezier(0.16,1,0.3,1)",
    "pulse-slow":      "pulse 3s ease-in-out infinite",
    "shimmer":         "shimmer 1.5s ease-in-out infinite",
    "progress-sweep":  "progressSweep 1.6s cubic-bezier(0.65,0.05,0.36,1) infinite",
    "blink":           "blink 1.1s steps(2,start) infinite",
    "radar-sweep":     "radarSweep 2.4s cubic-bezier(0.4,0,0.6,1) infinite",
    "verdict-enter":   "verdictEnter 320ms cubic-bezier(0.16,1,0.3,1) both",
    "intel-pulse":     "intelPulse 3s ease-in-out infinite",
    "scan-line":       "scanLine 1.8s ease-in-out infinite",
    "confidence-fill": "confidenceFill 600ms cubic-bezier(0.16,1,0.3,1) both"
  },

  "keyframes": {
    "fadeIn":     { "from": { "opacity": "0" }, "to": { "opacity": "1" } },
    "scaleIn":    {
      "from": { "opacity": "0", "transform": "scale(0.95)" },
      "to":   { "opacity": "1", "transform": "scale(1)" }
    },
    "slideUp":    {
      "from": { "opacity": "0", "transform": "translateY(6px)" },
      "to":   { "opacity": "1", "transform": "translateY(0)" }
    },
    "slideRight": {
      "from": { "opacity": "0", "transform": "translateX(-6px)" },
      "to":   { "opacity": "1", "transform": "translateX(0)" }
    },
    "radarSweep": {
      "0%":   { "transform": "rotate(0deg)",   "opacity": "1"   },
      "85%":  { "transform": "rotate(306deg)", "opacity": "0.8" },
      "100%": { "transform": "rotate(360deg)", "opacity": "1"   }
    },
    "verdictEnter": {
      "from": { "opacity": "0", "transform": "translateY(8px) scale(0.97)" },
      "to":   { "opacity": "1", "transform": "translateY(0) scale(1)" }
    },
    "intelPulse": {
      "0%, 100%": { "opacity": "0.6" },
      "50%":      { "opacity": "1" }
    },
    "scanLine": {
      "0%":   { "transform": "translateX(-100%)", "opacity": "0" },
      "20%":  { "opacity": "0.6" },
      "80%":  { "opacity": "0.6" },
      "100%": { "transform": "translateX(100%)",  "opacity": "0" }
    },
    "confidenceFill": {
      "from": { "transform": "scaleX(0)", "transformOrigin": "left" },
      "to":   { "transform": "scaleX(1)", "transformOrigin": "left" }
    }
  }
}

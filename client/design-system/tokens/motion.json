{
  "_comment": "MARCOM Design Token Source of Truth — Motion",
  "_version": "1.0.0",
  "_principles": [
    "Slower = more expensive. Fast = cheap.",
    "Entrance: 320–400ms ease-out",
    "Loops (live system): 1.8s–3s subtle",
    "Never > 600ms for one-time transitions",
    "All animations must respect prefers-reduced-motion"
  ],

  "duration": {
    "instant":    "100ms",
    "fast":       "150ms",
    "base":       "200ms",
    "enter":      "320ms",
    "deliberate": "400ms",
    "fill":       "600ms"
  },

  "easing": {
    "out":         "ease-out",
    "spring":      "cubic-bezier(0.16,1,0.3,1)",
    "progress":    "cubic-bezier(0.65,0.05,0.36,1)",
    "linear":      "linear"
  },

  "animations": {
    "fade-in":         "fade-in 220ms ease-out",
    "scale-in":        "scale-in 200ms cubic-bezier(0.16,1,0.3,1)",
    "slide-up":        "slide-up 200ms cubic-bezier(0.16,1,0.3,1)",
    "slide-right":     "slide-right 200ms cubic-bezier(0.16,1,0.3,1)",
    "pulse-slow":      "pulse-slow 3s ease-in-out infinite",
    "shimmer":         "shimmer 1.5s ease-in-out infinite",
    "progress-sweep":  "progress-sweep 1.6s cubic-bezier(0.65,0.05,0.36,1) infinite",
    "blink":           "blink 1.1s steps(2,start) infinite",
    "radar-sweep":     "radar-sweep 2.4s cubic-bezier(0.4,0,0.6,1) infinite",
    "verdict-enter":   "verdict-enter 520ms cubic-bezier(0.16,1,0.3,1) both",
    "intel-pulse":     "intel-pulse 1.6s ease-in-out infinite",
    "scan-line":       "scan-line 1.8s ease-in-out infinite",
    "confidence-fill": "confidence-fill 600ms cubic-bezier(0.16,1,0.3,1) both"
  },

  "keyframes": {
    "fade-in": {
      "from": { "opacity": "0" },
      "to":   { "opacity": "1" }
    },
    "scale-in": {
      "0%":   { "opacity": "0", "transform": "scale(0.95)" },
      "100%": { "opacity": "1", "transform": "scale(1)" }
    },
    "slide-up": {
      "from": { "opacity": "0", "transform": "translateY(6px)" },
      "to":   { "opacity": "1", "transform": "translateY(0)" }
    },
    "slide-right": {
      "from": { "opacity": "0", "transform": "translateX(-8px)" },
      "to":   { "opacity": "1", "transform": "translateX(0)" }
    },
    "pulse-slow": {
      "0%, 100%": { "opacity": "1" },
      "50%":      { "opacity": "0.5" }
    },
    "shimmer": {
      "0%":   { "backgroundPosition": "-200% 0" },
      "100%": { "backgroundPosition": "200% 0" }
    },
    "progress-sweep": {
      "0%":   { "transform": "translateX(-100%)" },
      "100%": { "transform": "translateX(100%)" }
    },
    "blink": {
      "0%, 50%":  { "opacity": "1" },
      "51%, 100%": { "opacity": "0" }
    },
    "radar-sweep": {
      "0%":   { "transform": "rotate(0deg)",   "opacity": "1"   },
      "85%":  { "transform": "rotate(306deg)", "opacity": "0.8" },
      "100%": { "transform": "rotate(360deg)", "opacity": "1"   }
    },
    "verdict-enter": {
      "from": { "opacity": "0", "transform": "translateY(8px) scale(0.97)" },
      "to":   { "opacity": "1", "transform": "translateY(0) scale(1)" }
    },
    "intel-pulse": {
      "0%, 100%": { "opacity": "0.6" },
      "50%":      { "opacity": "1" }
    },
    "scan-line": {
      "0%":   { "transform": "translateX(-100%)", "opacity": "0" },
      "20%":  { "opacity": "0.6" },
      "80%":  { "opacity": "0.6" },
      "100%": { "transform": "translateX(100%)",  "opacity": "0" }
    },
    "confidence-fill": {
      "from": { "transform": "scaleX(0)", "transformOrigin": "left" },
      "to":   { "transform": "scaleX(1)", "transformOrigin": "left" }
    }
  }
}

{
  "name": "lumi-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .js,.jsx --max-warnings 0",
    "lint:tokens": "eslint src/ --ext .js,.jsx --rule 'marcom-ds/no-generic-tailwind: error' --max-warnings 0",
    "lint:ci": "eslint src/ --ext .js,.jsx --max-warnings 0 --format compact",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "arch-check": "cd .. && node scripts/arch-check.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@marcom/runtime-contracts": "*",
    "@vitejs/plugin-react": "^4.3.4",
    "@xstate/react": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "xstate": "^5.31.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "vitest": "^4.1.6"
  }
}

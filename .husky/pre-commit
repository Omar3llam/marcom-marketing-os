#!/usr/bin/env sh
# ============================================================
# MARCOM / Lumi — pre-commit hook
# ------------------------------------------------------------
# GUARD 1: JS syntax check (npm run check)
#   Blocks commits if any src/*.js file has a SyntaxError.
#   Catches TypeScript-style syntax (as X, : Type, etc.) that
#   Node.js would reject at runtime.
#
# GUARD 2: ESLint scan
#   Catches undefined vars, unused imports, etc.
#
# GUARD 3: Client rebuild (if src or config changed)
#   Rebuilds client/dist/ and re-stages it so the deployed
#   artefact is never out of sync with source.
# ============================================================

echo "🔍 Running JS syntax check..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Syntax errors found in .js files. Fix before committing."
  exit 1
fi

echo "🔍 Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint errors found. Run 'npm run lint:fix' or fix manually."
  exit 1
fi

echo "🔍 Checking for @/ path aliases in backend..."
ALIAS_COUNT=$(grep -rn "from '@/" src/ --include="*.js" 2>/dev/null | wc -l)
if [ "$ALIAS_COUNT" -gt "0" ]; then
  echo "❌ Found $ALIAS_COUNT @/ alias import(s) in src/. Node.js cannot resolve these at runtime."
  echo "   Replace with relative paths (e.g. '../lib/prisma.js')"
  grep -rn "from '@/" src/ --include="*.js"
  exit 1
fi
echo "✅ No @/ aliases in backend."

echo "✅ Syntax, lint, and alias checks passed."

# ── Client rebuild (only when client source is staged) ──────
CLIENT_TRIGGER_REGEX='^client/(src/|index\.html$|package(-lock)?\.json$|vite\.config\.js$|tailwind\.config\.js$|postcss\.config\.js$)'

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$CLIENT_TRIGGER_REGEX" || true)

if [ -z "$STAGED" ]; then
  echo "✅ All pre-commit checks passed."
  exit 0
fi

echo ""
echo "──────────────────────────────────────────────────"
echo "  pre-commit: client source changed → rebuilding"
echo "──────────────────────────────────────────────────"
echo "$STAGED" | sed 's/^/  · /'
echo ""

if ! npm run build --prefix client; then
  echo ""
  echo "✗ pre-commit: vite build failed — commit aborted."
  echo "  Fix the build, then re-stage and commit again."
  exit 1
fi

git add client/dist

echo ""
echo "✓ pre-commit: client/dist rebuilt and staged."
echo "✅ All pre-commit checks passed."
echo ""

{
  "name": "marcom",
  "version": "4.1.0",
  "description": "MARCOM — AI Marketing Co-pilot SaaS (Production-Ready)",
  "main": "src/server.js",
  "type": "module",
  "workspaces": [
    "packages/*",
    "client"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "build": "node -e \"console.log('===PRE BUILD===','cwd=',process.cwd(),'| DATABASE_URL set:',Boolean(process.env.DATABASE_URL))\" && npm install --include=dev && echo '===PRISMA GENERATE===' && npx prisma generate && node scripts/prisma-migrate-safe.js && echo '===VITE BUILD===' && npm run build --workspace client && node -e \"const f=require('fs');const p=require('path');const i=p.resolve('client/dist/index.html');console.log('===POST BUILD=== exists:',f.existsSync(i),'| path:',i)\"",
    "build:client": "npm run build --workspace client",
    "build:migrate": "node scripts/migrate.js",
    "prepare": "husky || true",
    "migrate": "node scripts/migrate.js",
    "setup": "node scripts/setup-airtable.js",
    "test": "node scripts/test-system.js",
    "create-memory": "node scripts/create-memory.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "migrate:credentials": "node scripts/migrate-credentials-to-oauth.js",
    "worker": "node src/workers/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "node scripts/check.js",
    "arch-check": "node scripts/arch-check.js",
    "arch-check:ci": "node scripts/arch-check.js 2>&1 | tee arch-check.log; exit ${PIPESTATUS[0]}",
    "security-check": "node scripts/security-check.js",
    "prestart": "npm run check"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@marcom/runtime-contracts": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "airtable": "^0.12.2",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "openai": "^4.73.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.0",
    "redis": "^4.7.1",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.9.16"
    },
    "@types/request": {
      "form-data": "^2.5.6"
    }
  }
}

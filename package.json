{
  "name": "marcom",
  "version": "4.1.0",
  "description": "MARCOM — AI Marketing Co-pilot SaaS (Production-Ready)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "build": "node -e \"console.log('===PRE BUILD===','cwd=',process.cwd(),'| VITE_CLERK key set:',Boolean(process.env.VITE_CLERK_PUBLISHABLE_KEY),'| DATABASE_URL set:',Boolean(process.env.DATABASE_URL))\" && npm install --include=dev && npm install --include=dev --prefix client && echo '===PRISMA GENERATE===' && npx prisma generate && echo '===PRISMA DB PUSH===' && (npx prisma db push --skip-generate --accept-data-loss || echo '[!] prisma db push failed — DB-touching routes will 500 until DATABASE_URL is reachable') && echo '===VITE BUILD===' && npm run build --prefix client && node -e \"const f=require('fs');const p=require('path');const i=p.resolve('client/dist/index.html');console.log('===POST BUILD=== exists:',f.existsSync(i),'| path:',i)\"",
    "build:client": "npm run build --prefix client",
    "build:migrate": "node scripts/migrate.js",
    "postinstall": "npm install --include=dev --prefix client --no-audit --no-fund",
    "prepare": "husky || true",
    "migrate": "node scripts/migrate.js",
    "setup": "node scripts/setup-airtable.js",
    "test": "node scripts/test-system.js",
    "create-memory": "node scripts/create-memory.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:credentials": "node scripts/migrate-credentials-to-oauth.js",
    "worker":       "node src/workers/index.js",
    "lint":         "eslint src/",
    "lint:fix":     "eslint src/ --fix",
    "check":        "node scripts/check.js",
    "arch-check":   "node scripts/arch-check.js",
    "arch-check:ci":"node scripts/arch-check.js 2>&1 | tee arch-check.log; exit ${PIPESTATUS[0]}",
    "prestart":     "npm run check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@clerk/express": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "airtable": "^0.12.2",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.13",
    "openai": "^4.73.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.0",
    "redis": "^4.7.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

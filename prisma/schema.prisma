// ============================================================
// MARCOM / Lumi — Prisma Schema (Phase 1: Temporal Brain)
// ============================================================
// Database: PostgreSQL
// Generator: prisma-client-js
//
// This schema introduces the persistent "temporal intelligence"
// layer for Lumi: Workspaces, Users, OAuth tokens, execution
// audit + idempotency, Decision memory, and Webhook deduplication.
//
// The Action engine and Campaign state tracking this paragraph used to name
// were both removed once production measured them at 0 rows with no writer:
// see 20260823000000_sc1_campaignstate_closure and the SC-2 Action closure.
//
// IMPORTANT: This schema is additive. It does NOT yet replace
// the existing Airtable-backed `MARCOM_Sessions` table or the
// Postgres tables used by /api/history/* and /api/projects/*.
// Migration paths for those legacy stores are listed in the
// "Migration conflict notes" section accompanying this file.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Required for migrations on Neon pooler (falls back to DATABASE_URL if not set)
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  PENDING
  PAUSED_FOR_APPROVAL
  RESUMING
  RESUMED
}

enum ActionType {
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  INCREASE_BUDGET
  DECREASE_BUDGET
  PAUSE_ADSET
  RESUME_ADSET
  SCALE_CAMPAIGN
  OPTIMIZE_CAMPAIGN
  // Phase 2 — first-class verdict execution paths
  REALLOCATE_BUDGET
  REFRESH_CREATIVE
}

// ── Phase 1: Marketing OS substrate enums ────────────────────
// The platform an entity physically lives on.
enum Channel {
  META
  GOOGLE
  TIKTOK
  SNAP
  LINKEDIN
}

// Level of an entity in the normalized graph
// (Account → Campaign → AdSet → Ad → Creative).
enum EntityLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
  CREATIVE
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// Origin of a metric. Intentionally distinct from `Channel`:
// a Meta entity can have conversion truth sourced from GA4 or
// Shopify. Keeping this separate from day one means the
// Conversion Truth join (Phase N) does NOT require a table rebuild.
enum DataSource {
  META
  GOOGLE
  TIKTOK
  SNAP
  LINKEDIN
  GA4
  SHOPIFY
  MANUAL
}

// Time grain of a MetricSnapshot row.
//
// WARNING — this enum does NOT describe what a row measures. Every writer
// (snapshotSink, actualsSink, RevenueCsvService, seed) hardcodes DAILY, and has
// done so on rows that are 90-day and lifetime aggregates. Reading DAILY here as
// proof of a daily observation is the exact mistake `measurementWindow` exists
// to make impossible. See MeasurementWindow below.
enum Granularity {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

// What period a MetricSnapshot row's metrics actually cover.
//
// `granularity` above could not answer this and never could: it is hardcoded
// DAILY by every writer. `date` cannot answer it either — it is the SYNC
// timestamp, not a measurement date — so a row synced on 2026-08-02 might hold
// 90 days of delivery, or Meta's full ~37-month retention, depending only on
// whether a cron tick or a human's Sync click wrote it last.
//
// Recording, never inferring. A row says what it is because its producer knew;
// nothing here is derived from `date`, `granularity`, or sync cadence.
enum MeasurementWindow {
  // Provenance not established. Two distinct cases, deliberately one value —
  // both mean "unusable for canonical-window resolution", which is all any
  // reader needs to know:
  //   • rows written before this column existed, whose request preset was never
  //     persisted and cannot be recovered;
  //   • rows from a source that carries no measurement period at all (a revenue
  //     CSV upload, a GA4 actual) — see actualsSink / RevenueCsvService.
  LEGACY_UNKNOWN

  // A trailing-window aggregate over some arbitrary period — what every live
  // Meta and Google sync produces today (`last_90d` from cron, `maximum` from
  // the Sync button, or any preset a client passes). windowStart/windowEnd carry
  // the period Meta itself reported, so 90 days and 37 months stay distinct
  // without an enum value per preset.
  //
  // NOT interchangeable with CUMULATIVE_30D. A ROLLING_WINDOW row must never be
  // promoted to canonical because its dates happen to span ~30 days.
  ROLLING_WINDOW

  // Exactly one day of delivery — a true daily observation (Phase E,
  // time_increment=1). Additive across days: Σ is exact.
  DAILY

  // The canonical verdict window (Phase F). Cumulative over the trailing
  // CANONICAL_VERDICT_WINDOW_DAYS defined in verdict-engine/metricWindow.js,
  // which stays the single source of what "canonical" means — this enum records
  // only that a row claims to be it.
  CUMULATIVE_30D
}

// Marketing decision verdict (the Lumi call on an entity).
enum Verdict {
  KILL
  HOLD
  SCALE
  WATCH
  // Phase 2 — first-class verdicts with their own execution paths
  REALLOCATE
  REFRESH
}

// Comparator for guardrail rule conditions.
enum Comparator {
  GT
  GTE
  LT
  LTE
}

// Unit a guardrail threshold is expressed in.
enum ThresholdUnit {
  MINOR // integer minor units (money)
  RATIO // e.g. roas 2.4, frequency 3.5
  PCT // percentage points, e.g. "+50%" over target
}

// Phase 3 — capital allocation goal. Engine is goal-generic; only
// GROWTH_CEILING is implemented today (TARGET_CAC/TARGET_ROAS reserved).
enum GoalType {
  GROWTH_CEILING
}

// Lifecycle of a proposed allocation plan.
enum AllocationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

// ── Phase 4: Testing OS ──────────────────────────────────────
// The four dimensions a performance buyer actually tests each week.
enum TestDimension {
  HOOK
  OFFER
  AUDIENCE
  CREATIVE_ANGLE
}

// Lifecycle of an experiment. A test is "finished" only at CONCLUDED —
// when its outcome is read and written to Decision Memory.
enum TestStatus {
  PROPOSED
  RUNNING
  CONCLUDED
  ABANDONED
}

// ── Phase 5: Memory Moat ─────────────────────────────────────
// The kinds of durable pattern mined from one workspace's own history.
enum PatternKind {
  FATIGUE_CEILING
  SCALING_WINDOW
  CREATIVE_ANGLE_LONGEVITY
  SEASONAL_EFFECT
}

// Pattern lifecycle. ESTABLISHED requires recency-weighted support AND
// accuracy; SUPERSEDED/CONFLICTED are conflict-resolution outcomes (a
// reconciled or contested pattern is never promoted to a rule).
enum PatternStatus {
  EMERGING
  ESTABLISHED
  SUPERSEDED
  CONFLICTED
}

// ── Phase 6: Planning OS ─────────────────────────────────────
// Lifecycle of a forward-looking plan (budget + mix + tests + goal).
enum PlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// North-star tracking status. AT_RISK can fire from the lagging trend OR
// a leading fatigue signal that breaches before period end.
enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  INSUFFICIENT_EVIDENCE
  ACHIEVED
  MISSED
}

// Is current CAC sustainable given LTV? HEALTHY ≥ target (3.0),
// THIN 1–3, UNDERWATER < 1.
enum SustainabilityBand {
  HEALTHY
  THIN
  UNDERWATER
}

// ── Phase 7: Measurement OS ──────────────────────────────────
// Attribution/incrementality is Agency/Enterprise depth, OFF by default.
enum MeasurementTier {
  NONE
  AGENCY
  ENTERPRISE
}

// Attribution models. NOTE the deliberate absence of a DATA_DRIVEN id:
// market "DDA" means Google's path-based Shapley/Markov over user journeys,
// which we cannot compute honestly (no path data). Our causal model is
// INCREMENTALITY_WEIGHTED (credit by MEASURED holdout lift) — naming it
// DATA_DRIVEN would itself be a quiet lie.
enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LINEAR
  POSITION_BASED
  INCREMENTALITY_WEIGHTED
}

// A holdout is "finished" only at CONCLUDED — when its lift is read out
// with a confidence interval and written to memory.
enum IncrementalityStatus {
  DESIGNED
  RUNNING
  CONCLUDED
  ABANDONED
}

// The confidence half of the honesty contract.
enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// ── Phase 8: Collaboration & Reporting OS ────────────────────
// Collaboration role — orthogonal to the system UserRole (ADMIN/VIEWER).
// A null collabRole falls back to STRATEGIST so seats predating Phase 8 are
// never locked out.
enum WorkspaceRole {
  STRATEGIST
  BUYER
  CLIENT
}

// Team & Roles — lifecycle of an emailed workspace invitation. The actual
// JOIN happens in firebaseAuth auto-provision: a first-time signup whose email
// has a PENDING, unexpired invite lands in the inviting workspace instead of a
// fresh one (single-use → marked ACCEPTED on join).
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum NarrativePeriod {
  WEEKLY
  MONTHLY
}

enum NarrativeAudience {
  STRATEGIST
  BUYER
  LEADERSHIP
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

// The collaboration audit-log event types (CollaborationEvent). Distinct from
// the execution-typed AuditLog so we never overload ActionType.
enum CollaborationEventType {
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  HANDOFF
  NARRATIVE_GENERATED
  // C-05 — promoting a learned pattern hands Lumi durable authority to JUDGE
  // and RAISE on its own. (The rule it creates still writes PROPOSED, so the
  // grant is never authority to ACT.) That is neither an approval decision nor
  // a handoff: it is the grant itself, and its withdrawal. Filing either under
  // APPROVAL_DECIDED would make the moment autonomy changed hands unfindable
  // in the log that exists to record it.
  AUTONOMY_GRANTED
  AUTONOMY_REVOKED
}

// ── Phase 9: Agentic OS ──────────────────────────────────────
// What kicked off a loop sweep.
enum LoopTrigger {
  SCHEDULED // the cron heartbeat (proactive)
  MANUAL // a human pressed "Run sweep now"
  ON_READ // the home loaded and the last sweep was stale (no cron)
}

// Overall loop health — a queryable column so monitoring doesn't dig JSON.
enum LoopHealth {
  HEALTHY // closed loop, nothing stale
  DEGRADED // a non-blocking stage is ageing/stale
  STALLED // proposals piling up unexecuted, or the loop never closed
}

enum WebhookProvider {
  META
  GOOGLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum TransitionActor {
  WORKER
  TIMEOUT_HANDLER
  USER
  API
  RECONCILIATION
  RETRY_POLICY
  SYSTEM
}

// ── Core Models ──────────────────────────────────────────────

model Workspace {
  canonicalRefreshes CanonicalRefresh[]
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("USD") // ISO 4217 currency code (EGP, USD, SAR, AED, etc.)
  createdAt DateTime @default(now())

  // ── Onboarding preferences (promoted from User.context so workspace-scoped
  // services can read them — see routes/campaigns/context.js). All nullable /
  // empty-default: existing rows and skipped steps never break.
  spendTier  String?  // onboarding tier id: 't1'..'t4' (no billing meaning)
  objective  String?  // onboarding goal id: 'roas' | 'conversions' | 'ltv' | 'custom'
  adChannels String[] // normalized Channel values the account runs, e.g. ['META','GOOGLE']

  // ── Feature-gating entitlement (FREE | GROWTH | PRO) ─────────
  // The plan the workspace is ENTITLED to — drives which surfaces unlock in the
  // UI (usePlan/PlanGate). Admin-controlled only (there is no billing): default
  // FREE for every workspace, raised via the admin panel. Deliberately NOT the
  // same axis as onboarding's aspirational plan pick (starter/pro/agency, free
  // during early access, never persisted) — wiring those would be a self-serve
  // upgrade bypass. Also independent of `measurementTier` (attribution paywall).
  plan       String   @default("FREE")

  // ── Phase 5: network memory (opt-in, anonymized) ─────────────
  // Sharing this account's anonymized patterns into the cross-account
  // network is OFF by default — a governance decision, never a default.
  networkConsent Boolean   @default(false)
  cohortTag      String? // e.g. "EG-apparel" — the anonymization cohort
  consentedAt    DateTime?

  users                      User[]
  auditLogs                  AuditLog[]
  artifacts                  Artifact[]
  artifactApprovals          ArtifactApproval[]
  approvalDecisions          ApprovalDecision[]
  publishedCreatives         PublishedCreative[]
  providerPerformanceMetrics ProviderPerformanceMetrics[]
  contentGenerations         ContentGeneration[]
  reinforcementSnapshots     ReinforcementSnapshot[]

  // ── Phase 1: Marketing OS substrate ──────────────────────────
  accounts              Account[]
  campaignEntities      Campaign[]
  adSets                AdSet[]
  ads                   Ad[]
  creatives             Creative[]
  metricSnapshots       MetricSnapshot[]
  decisions             Decision[]
  outcomeSnapshots      OutcomeSnapshot[]
  decisionMemoryEntries DecisionMemoryEntry[]
  fatiguePredictions    FatiguePrediction[]
  guardrailRules        GuardrailRule[]
  allocationPlans       AllocationPlan[]
  testExperiments       TestExperiment[]
  accountPatterns       AccountPattern[]
  patternObservations   PatternObservation[]

  // ── Phase 6: Planning OS ─────────────────────────────────────
  accountEconomics AccountEconomics?
  plans            Plan[]
  northStarGoals   NorthStarGoal[]

  // ── Phase 7: Measurement OS ──────────────────────────────────
  // Attribution/incrementality is gated; OFF by default (not core).
  measurementTier     MeasurementTier      @default(NONE)
  incrementalityTests IncrementalityTest[]
  pathTouches         PathTouch[]

  // ── Phase 8: Collaboration & Reporting OS ────────────────────
  stakeholderNarratives StakeholderNarrative[]
  approvalRequests      ApprovalRequest[]
  collaborationEvents   CollaborationEvent[]
  invitations           Invitation[]

  // ── Phase 9: Agentic OS ──────────────────────────────────────
  loopRuns           LoopRun[]
  campaignReasonings CampaignReasoning[]

  // R12-1c — back-reference required by the ExecutionRequest.workspace relation.
  executionRequests ExecutionRequest[]

  @@map("workspaces")
}

// 02B-1 additive capture-only storage. Native migration owns CHECKs, deferral,
// guards, event clocks and grants. Prisma diff cannot audit those constructs.
// No runtime capture writer is installed. Do not use db push for these models.
model CanonicalRefresh {
  workspaceId String @map("workspace_id") @db.Uuid
  id String @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  recordVersion Int @default(1) @map("record_version") @db.SmallInt
  platform String @default("META")
  providerAccountId String @map("provider_account_id")
  measurementWindow String @default("CUMULATIVE_30D") @map("measurement_window")
  requestedStart DateTime @map("requested_start") @db.Date
  requestedEnd DateTime @map("requested_end") @db.Date
  scopeDescriptor Json @map("scope_descriptor")
  scopeHash Bytes @map("scope_hash")
  accountSetHash Bytes @map("account_set_hash")
  retryOfRefreshId String? @map("retry_of_refresh_id") @db.Uuid
  correlationId String? @map("correlation_id")
  selectedCampaignId String? @map("selected_campaign_id") @db.Uuid
  selectedAdsetId String? @map("selected_adset_id") @db.Uuid
  selectedAdId String? @map("selected_ad_id") @db.Uuid
  notStartedLevels Json @default("[]") @map("not_started_levels")
  attemptDispositions Json? @map("attempt_dispositions")
  selectionHash Bytes? @map("selection_hash")
  sourceSealedAt DateTime? @map("source_sealed_at") @db.Timestamptz(3)
  // Required in Prisma input, but always DB-stamped by the admission guard.
  retainUntil DateTime @map("retain_until") @db.Timestamptz(3)
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
  retryOf CanonicalRefresh? @relation("CanonicalRefreshRetry",fields:[workspaceId,retryOfRefreshId],references:[workspaceId,id],onDelete:NoAction,onUpdate:NoAction)
  retries CanonicalRefresh[] @relation("CanonicalRefreshRetry")
  attempts CanonicalLevelAttempt[] @relation("CanonicalSourceAttempts")
  selectedCampaign CanonicalLevelAttempt? @relation("CanonicalCampaignSelection",fields:[workspaceId,id,selectedCampaignId],references:[workspaceId,refreshId,id],onDelete:NoAction,onUpdate:NoAction,map:"canonical_selection_campaign_fk")
  selectedAdset CanonicalLevelAttempt? @relation("CanonicalAdsetSelection",fields:[workspaceId,id,selectedAdsetId],references:[workspaceId,refreshId,id],onDelete:NoAction,onUpdate:NoAction,map:"canonical_selection_adset_fk")
  selectedAd CanonicalLevelAttempt? @relation("CanonicalAdSelection",fields:[workspaceId,id,selectedAdId],references:[workspaceId,refreshId,id],onDelete:NoAction,onUpdate:NoAction,map:"canonical_selection_ad_fk")
  writes CanonicalWriteAttempt[]
  @@id([workspaceId,id])
  @@index([workspaceId,createdAt])
  @@index([retainUntil,workspaceId,id])
  @@index([workspaceId,retryOfRefreshId])
  @@map("canonical_refreshes")
}

model CanonicalLevelAttempt {
  workspaceId String @map("workspace_id") @db.Uuid
  refreshId String @map("refresh_id") @db.Uuid
  id String @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  recordVersion Int @default(1) @map("record_version") @db.SmallInt
  level String
  ordinal Int
  retryOfAttemptId String? @map("retry_of_attempt_id") @db.Uuid
  requestDescriptor Json @map("request_descriptor")
  requestHash Bytes @map("request_hash")
  callIntentAt DateTime @map("call_intent_at") @db.Timestamptz(3)
  sourceReceipt Json? @map("source_receipt")
  receiptHash Bytes? @map("receipt_hash")
  sourceSealedAt DateTime? @map("source_sealed_at") @db.Timestamptz(3)
  refresh CanonicalRefresh @relation("CanonicalSourceAttempts",fields:[workspaceId,refreshId],references:[workspaceId,id],onDelete:Cascade,onUpdate:NoAction)
  retryOf CanonicalLevelAttempt? @relation("CanonicalLevelRetry",fields:[workspaceId,refreshId,retryOfAttemptId],references:[workspaceId,refreshId,id],onDelete:NoAction,onUpdate:NoAction)
  retries CanonicalLevelAttempt[] @relation("CanonicalLevelRetry")
  observations CanonicalObservation[]
  // Inverse lists deliberately avoid Prisma's invalid introspected 1:1 model.
  selectedCampaignRefreshes CanonicalRefresh[] @relation("CanonicalCampaignSelection")
  selectedAdsetRefreshes CanonicalRefresh[] @relation("CanonicalAdsetSelection")
  selectedAdRefreshes CanonicalRefresh[] @relation("CanonicalAdSelection")
  @@id([workspaceId,refreshId,id])
  @@unique([workspaceId,id])
  @@unique([workspaceId,refreshId,level,ordinal])
  @@index([workspaceId,refreshId,retryOfAttemptId])
  @@map("canonical_level_attempts")
}

model CanonicalWriteAttempt {
  workspaceId String @map("workspace_id") @db.Uuid
  refreshId String @map("refresh_id") @db.Uuid
  id String @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  recordVersion Int @default(1) @map("record_version") @db.SmallInt
  ordinal Int
  retryOfWriteId String? @map("retry_of_write_id") @db.Uuid
  sourceSelectionHash Bytes @map("source_selection_hash")
  plannedPayloadHash Bytes? @map("planned_payload_hash")
  plannedAt DateTime? @map("planned_at") @db.Timestamptz(3)
  outcome String?
  errorCode String? @map("error_code")
  commitManifest Json? @map("commit_manifest")
  outcomeHash Bytes? @map("outcome_hash")
  sealedAt DateTime? @map("sealed_at") @db.Timestamptz(3)
  committedAt DateTime? @map("committed_at") @db.Timestamptz(3)
  refresh CanonicalRefresh @relation(fields:[workspaceId,refreshId],references:[workspaceId,id],onDelete:Cascade,onUpdate:NoAction)
  retryOf CanonicalWriteAttempt? @relation("CanonicalWriteRetry",fields:[workspaceId,refreshId,retryOfWriteId],references:[workspaceId,refreshId,id],onDelete:NoAction,onUpdate:NoAction)
  retries CanonicalWriteAttempt[] @relation("CanonicalWriteRetry")
  observations CanonicalObservation[]
  @@id([workspaceId,refreshId,id])
  @@unique([workspaceId,id])
  @@unique([workspaceId,refreshId,ordinal])
  @@index([workspaceId,refreshId,retryOfWriteId])
  @@map("canonical_write_attempts")
}

model CanonicalObservation {
  workspaceId String @map("workspace_id") @db.Uuid
  id String @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  recordVersion Int @default(1) @map("record_version") @db.SmallInt
  refreshId String @map("refresh_id") @db.Uuid
  writeId String @map("write_id") @db.Uuid
  sourceAttemptId String @map("source_attempt_id") @db.Uuid
  entityId String @map("entity_id") @db.Uuid
  entityLevel String @map("entity_level")
  externalEntityId String? @map("external_entity_id")
  date DateTime @db.Timestamp(3)
  granularity String
  source String
  measurementWindow String @map("measurement_window")
  windowStart DateTime? @map("window_start") @db.Timestamp(3)
  windowEnd DateTime? @map("window_end") @db.Timestamp(3)
  materializedSnapshotId String? @map("materialized_snapshot_id") @db.Uuid
  committedProjection Json @map("committed_projection")
  sourceFacts Json @map("source_facts")
  contentHash Bytes @map("content_hash")
  write CanonicalWriteAttempt @relation(fields:[workspaceId,refreshId,writeId],references:[workspaceId,refreshId,id],onDelete:Cascade,onUpdate:NoAction)
  sourceAttempt CanonicalLevelAttempt @relation(fields:[workspaceId,refreshId,sourceAttemptId],references:[workspaceId,refreshId,id],onDelete:Cascade,onUpdate:NoAction)
  @@id([workspaceId,id])
  @@unique([workspaceId,refreshId,writeId,entityId,entityLevel,date,granularity,source,measurementWindow])
  @@index([workspaceId,refreshId,sourceAttemptId])
  @@map("canonical_observations")
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  email       String         @unique
  // ── Clerk → JWT cutover ────────────────────────────────────
  // Nullable string mapping the legacy Clerk subject (e.g.
  // "user_2abcXYZ...") to the new internal UUID. AuthMiddleware
  // resolves an inbound JWT `sub` claim to User.id via this column
  // until Clerk is fully retired in Phase 5+.
  clerkId     String?        @unique
  role        UserRole       @default(VIEWER)
  // ── Phase 8: collaboration role (orthogonal to system `role`) ──
  // STRATEGIST / BUYER / CLIENT. Null ⇒ treated as STRATEGIST by roleScope.
  collabRole  WorkspaceRole?
  // ── Onboarding context (B3 decision) ───────────────────────
  // Brand voice / business model / market / etc. captured by the
  // OnboardingPage wizard. JSON shape is defined by the client
  // (see client/src/pages/OnboardingPage.jsx). Null until the
  // user completes onboarding; blocks the /app route until set.
  context     Json?
  createdAt   DateTime       @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentGenerations ContentGeneration[]

  @@index([workspaceId])
  @@map("users")
}

// ── Content Lab: saved generations (history) ─────────────────
// One row per successful Content Lab generation. Persisted best-effort AFTER
// the AI call so a save failure never blocks the response. Workspace-scoped so
// the team shares a history; `createdById` is the internal User.id (resolved
// from the Firebase uid via clerkId — NEVER req.userId, which is the uid).
// `content` = the returned { copy, headlines, ctas, visual, video }; `context`
// = what it was generated for (campaign/tone/brand/audience/industry/objective/
// format/options). Both JSON — the shape is owned by the route, not the schema.
model ContentGeneration {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  createdById String   @db.Uuid
  content     Json
  context     Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("content_generations")
}

// ── Campaign verdict reasoning: pre-generated "Lumi's Read" ──────
// One row per campaign (upsert). Written best-effort during the agentic sweep
// (top-N by impact score) so the campaign drill-down shows an INSTANT, plain-
// language read of the verdict instead of an on-demand LLM round-trip.
// `reasoning` is prose from the AI gateway; `verdict`/`impactScore` are the
// signals AT generation time (lets the UI show "stale" when they drift or the
// row ages out). `sweepId` = the LoopRun that produced it. Non-authoritative —
// safe to wipe and regenerate on any sweep. Workspace-scoped so the team shares.
model CampaignReasoning {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  entityId    String   // connector campaign entityId (deterministic; not a DB uuid)
  reasoning   String
  verdict     String
  impactScore Int?
  sweepId     String?  // LoopRun.id that generated this (null when ad-hoc)
  generatedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityId])
  @@index([workspaceId, generatedAt(sort: Desc)])
  @@map("campaign_reasonings")
}

// ── Team & Roles: workspace invitation ───────────────────────
// One PENDING invite per (workspace, email). The token backs the email accept
// link; the join itself is email-matched in the firebaseAuth seam, so the token
// is opaque/single-use (status flips to ACCEPTED on first join). Cascade-deletes
// with its workspace, so a deleted workspace never strands a live invite.
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String           @db.Uuid
  email       String
  collabRole  WorkspaceRole    @default(BUYER)
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@index([workspaceId])
  @@map("invitations")
}

// NOTE: The OAuthToken model (table "oauth_tokens") was removed in SC-4.
// It was a destination that never received anything: production measured 0
// rows, no runtime reader or writer existed, and the only thing that could
// fill it was a manual `migrate:credentials` script copying LIVE credential
// ciphertext OUT of marcom_credentials — the store named just below — INTO a
// table with no rotation, no revocation on disconnect and no purge path.
// The cutover it was built for never happened; Phase 12B/12c re-pointed the
// connector layer onto marcom_credentials instead. Script and npm command
// were retired with the model. Dropped in 20260823110000_sc4_oauthtoken_closure.

// NOTE: The Integration model (table "integrations") was removed 2026-06-15.
// It was write-dead — nothing populated it — and every Meta/Google credential
// read now goes through credentialStore (marcom_credentials), the
// OAuth-authoritative store. Dropped in migration 20260615000000_drop_integration_model.

model AuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  userId       String          @db.Uuid
  // SC-2 — this was the FK to the legacy Action table, which is gone. The
  // COLUMN stays: dropping a column from a live table is a data decision, and
  // production was measured for `actions` (0 rows), not for how many audit rows
  // carry a non-null actionId. What went is the CONSTRAINT and the relation,
  // both of which pointed at a table that no longer exists.
  //
  // Nothing has ever written it. All three `auditLog.create` calls in
  // routes/execution/meta.js omit it, so every row this system has produced
  // carries null. It is named residue, not a live reference — closing it needs
  // its own production count.
  actionId     String?         @db.Uuid
  actionType   ActionType
  targetId     String // Campaign ID, AdSet ID, etc.
  platform     String // e.g., "META", "GOOGLE"
  status       ExecutionStatus @default(PENDING)
  payload      Json? // Original request payload
  response     Json? // Platform response
  errorMessage String? // If status = FAILED
  performedAt  DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, performedAt(sort: Desc)])
  @@index([targetId])
  @@index([actionType])
  @@index([status])
  @@map("audit_logs")
}

// ── Idempotency Protection ──────────────────────────────────
// Prevents duplicate Meta executions from double-clicks, retries,
// and flaky networks. Each execution request generates a unique
// idempotencyKey. If the same key arrives again, we replay the
// stored response instead of re-executing on Meta.

model ExecutionRequest {
  id          String @id @default(cuid())
  workspaceId String @db.Uuid
  // ── R11 (I65) — the idempotency key is workspace-qualified ──
  // This was GLOBALLY unique and fully client-supplied, and the lookup that
  // read it carried no workspace. Two consequences, both reachable from the
  // route: presenting another workspace's key returned that workspace's
  // executionId, status, and stored Meta API response; and pre-claiming a key
  // another workspace was about to use made their genuine request come back
  // `idempotentReplay: true`, telling them an ad-platform action had succeeded
  // that was never queued.
  //
  // Uniqueness now spans (workspaceId, idempotencyKey): the guarantee the
  // feature actually needs — "this workspace must not execute this twice" —
  // rather than a global namespace shared with every tenant. See the compound
  // @@unique below; the column itself carries no unique constraint.
  idempotencyKey String
  actionType     String
  targetId       String
  status         String // PENDING, QUEUED, EXECUTING, EXECUTED_SUCCESS, EXECUTED_FAILED, TIMED_OUT, CANCELLED
  payload        Json? // Original request payload
  response       Json? // Meta API response (success or error)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Phase 11B: Lifecycle Governance ───────────────────────
  version       Int     @default(0) // Optimistic concurrency control (OCC)
  correlationId String? // Correlation lineage for distributed tracing
  activeStep    String? // Current orchestration step
  retryMetadata Json? // { attempt, maxAttempts, nextRetryAt }

  // ── R10 (I55) — execution attribution ─────────────────────
  // WHICH DECISION THIS EXECUTION CARRIES OUT. Before this column a real Meta
  // mutation had no link back to the call that prompted it, so the Proof Engine
  // could only ever see decisions a human had separately clicked "I did this"
  // on — every actual platform action was invisible to it.
  //
  // Nullable, and permanently so. Not every execution comes from a Decision: an
  // operator can act on a campaign no sweep has written a verdict for, and a
  // rollback inverts an action rather than carrying out a call. A required
  // column would force those paths to invent an attribution, which is the
  // failure this exists to prevent — an unattributed execution must be able to
  // say so.
  //
  // SetNull, not Cascade: deleting a Decision must not delete the audit record
  // of a mutation that really happened on the ad platform.
  decisionId String?   @db.Uuid
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  // ── R12-1c — the tenant key finally gets referential integrity ──
  // `workspaceId` has been on this model since 20260518 and every sibling
  // (AuditLog, User) declares its Workspace relation —
  // this one never did, so no FK backed it. Two migrations tried to add the
  // constraint under IF NOT EXISTS guards and both recorded a clean apply, yet
  // production had no such constraint: a `db push` reconciled the database to
  // this model, and this model did not ask for one.
  //
  // It matters more since R11: @@unique([workspaceId, idempotencyKey]) makes
  // workspaceId load-bearing for a tenant-isolation guarantee, and an
  // unconstrained value there cannot be caught by the database.
  //
  // Cascade on delete matches every other workspace-owned table. Cascade on
  // update is what the deployed FKs already carry (Prisma's implicit default),
  // stated explicitly here so the contract is readable rather than inferred.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  transitions       ExecutionTransition[]
  metrics           ExecutionMetric[]
  artifacts         Artifact[]
  checkpoints       ExecutionCheckpoint[]
  approvalDecisions ApprovalDecision[]

  // R11 (I65) — replaces the global @unique on idempotencyKey. A client-supplied
  // identifier must never occupy a namespace shared across tenants.
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([status])
  @@index([correlationId])
  // R10 — "which executions carried out this decision", the read the worker's
  // first-success stamp and any later audit both need.
  @@index([decisionId])
  @@map("execution_requests")
}

// ── Phase 11B Task 7: ExecutionTransition Audit Log ──────────
// Immutable append-only log of every state transition.
// Enables forensic debugging, replay, timeline UI, and incident analysis.
//
// Architectural Law:
// Every state mutation must emit a durable transition record.
//
// Query patterns:
// - Execution timeline: WHERE executionId = ? ORDER BY createdAt
// - Actor audit: WHERE actor = 'worker' AND workspaceId = ?
// - Version conflicts: WHERE executionId = ? AND previousVersion != newVersion - 1
// - Correlation lineage: WHERE correlationId = ? ORDER BY createdAt

model ExecutionTransition {
  id          String @id @default(cuid())
  executionId String
  workspaceId String @db.Uuid

  fromStatus String
  toStatus   String

  actor TransitionActor

  correlationId String?
  reason        String? // e.g., "sse_disconnect", "timeout_exceeded", "user_cancel"

  previousVersion Int
  newVersion      Int

  metadata Json? // Optional metadata (e.g., retry attempt, error context)

  createdAt DateTime @default(now())

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actor])
  @@index([correlationId])
  @@map("execution_transitions")
}

// ── PR #14: Execution Metrics ────────────────────────────────
// Append-only record written after every terminal transition.
// Used by GET /api/execute/metrics/summary.
// READ-ONLY from the observability layer — never mutates execution state.

model ExecutionMetric {
  id          String @id @default(cuid())
  executionId String
  workspaceId String @db.Uuid

  // Timing (derived from ExecutionTransition audit log)
  queueWaitMs Int? // PENDING → EXECUTING elapsed ms
  executionMs Int? // EXECUTING → terminal elapsed ms

  // Outcome counters
  retryCount      Int     @default(0)
  timeoutOccurred Boolean @default(false)

  // Agent attribution (from execution response payload)
  agentUsed     String? // "claude" | "openai" | "hybrid"
  tokenEstimate Int?

  finalStatus String // EXECUTED_SUCCESS | EXECUTED_FAILED | TIMED_OUT
  recordedAt  DateTime @default(now())

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordedAt(sort: Desc)])
  @@index([executionId])
  @@map("execution_metrics")
}

// ── PR #29: Execution Checkpoints ────────────────────────────
// Persistent state snapshots for resumable execution.
// Enables pause/resume capability for human-in-the-loop approval workflows.
//
// Architectural Law:
// Every execution pause must create a durable checkpoint.
//
// Query patterns:
// - Latest checkpoint: WHERE executionId = ? ORDER BY createdAt DESC LIMIT 1
// - Resume candidates: WHERE status = 'PAUSED' AND resumedAt IS NULL
// - Checkpoint timeline: WHERE executionId = ? ORDER BY createdAt

model ExecutionCheckpoint {
  id              String    @id @default(cuid())
  executionId     String
  workspaceId     String    @db.Uuid
  nodeId          String // Current node position in execution graph
  status          String // PAUSED_FOR_APPROVAL, RESUMING, RESUMED
  serializedState Json // Full execution graph state for deterministic resume
  pausedReason    String? // e.g., "awaiting_artifact_approval", "manual_pause"
  createdAt       DateTime  @default(now())
  resumedAt       DateTime?

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([status])
  @@map("execution_checkpoints")
}

// ── Webhook Deduplication ────────────────────────────────────

model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        WebhookProvider
  externalEventId String          @unique
  payload         Json
  processedAt     DateTime        @default(now())
  status          WebhookStatus   @default(RECEIVED)

  @@index([provider, status])
  @@map("webhook_events")
}

// ── PR #27: Artifact Storage ─────────────────────────────────
// Persistent storage for AI-generated artifacts (hooks, captions,
// visual briefs, etc.). Supports versioning, retrieval, and
// metadata tracking. Actual artifact content stored via adapter
// (local filesystem or S3), this table tracks metadata + location.

model Artifact {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  executionId String
  nodeId      String
  nodeType    String
  type        String // 'hook', 'caption', 'visual_brief', 'audience_hypothesis', 'angle', etc.
  storageKey  String // Adapter-specific storage location (local path or S3 key)
  capability  String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.
  provider    String // CLAUDE, OPENAI
  version     Int      @default(1)
  size        Int? // Artifact size in bytes
  contentHash String? // SHA256 hash for deduplication
  content     String? // Optional: store small artifacts inline (< 1KB)
  metadata    Json? // Provider metadata (tokens, latency, requestId, model, etc.)
  createdAt   DateTime @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution          ExecutionRequest    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approval           ArtifactApproval?
  decisions          ApprovalDecision[]
  publishedCreatives PublishedCreative[]

  @@index([workspaceId, type])
  @@index([executionId])
  @@index([nodeId])
  @@index([createdAt(sort: Desc)])
  @@index([contentHash])
  @@map("artifacts")
}

// ── PR #28: Artifact Approval Workflow ───────────────────────────
// Human-in-the-loop approval system for AI-generated artifacts.
// Enables review/approve/reject flow before publishing.
// Phase 1: Approval tracking (no runtime pause/resume yet).
//
// ── PR #30: Approval Decision Engine ─────────────────────────────
// Rich decision semantics beyond boolean approve/reject.
// Enables selective re-execution, escalation, and revision requests.
//
// Decision taxonomy:
// - APPROVED: Artifact ready for publishing
// - REJECTED: Artifact discarded, execution continues
// - REQUEST_REVISION: Request changes with specific instructions
// - REGENERATE: Re-run generation node with same inputs
// - ESCALATE: Route to human reviewer/manager for decision
//
// Architectural Law:
// rejection ≠ regeneration — different failure modes need different responses.

model ArtifactApproval {
  id          String @id @default(cuid())
  artifactId  String @unique
  workspaceId String @db.Uuid

  status     String // PENDING, COMPLETED (workflow state)
  decision   String? // APPROVED, REJECTED, REQUEST_REVISION, REGENERATE, ESCALATE (decision outcome)
  reviewerId String? @db.Uuid // User who made the decision
  feedback   String? // Decision reason/notes

  // PR #30: Rich decision metadata
  decisionMetadata Json? // { revisionInstructions, targetNodes, escalationReason, regenerationHint }
  escalatedTo      String?   @db.Uuid // User/role ID for escalation target
  escalatedAt      DateTime?

  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  artifact         Artifact          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalDecision ApprovalDecision?

  @@index([workspaceId, status])
  @@index([artifactId])
  @@index([status])
  @@index([decision])
  @@index([escalatedTo])
  @@index([createdAt(sort: Desc)])
  @@map("artifact_approvals")
}

// ── PR #37: Approval Decision Analytics ──────────────────────────
// Captures approval decisions for intelligence feedback loops.
// Enables provider performance tracking, feedback pattern detection,
// and artifact risk scoring.
//
// Architectural Law:
// Every approval decision must be recorded for learning.
//
// Query patterns:
// - Provider performance: WHERE provider = ? AND decision = ? GROUP BY decision
// - Feedback patterns: GROUP BY feedbackType ORDER BY count DESC
// - Artifact risk: WHERE capability = ? AND decision IN ('REGENERATE', 'REJECTED')
// - Reviewer behavior: WHERE reviewerId = ? AND reviewedAt > ?
// - Severity distribution: GROUP BY severity, decision

model ApprovalDecision {
  id          String @id @default(cuid())
  approvalId  String @unique
  artifactId  String
  executionId String
  workspaceId String @db.Uuid

  // Decision data (from frontend ApprovalForm)
  decision        String // APPROVED | REJECTED | REGENERATE | REQUEST_REVISION | ESCALATE
  feedback        String? // Free-form feedback text
  feedbackType    String? // hook_angle, tone, cta, clarity, length, brand_voice, etc.
  severity        String? // LOW | MEDIUM | HIGH
  preserveAspects String[] // brand_voice, tone, cta, color_palette, etc.

  // Attribution (from Artifact record for provider performance tracking)
  provider   String? // claude, openai, higgsfield
  capability String? // GENERATE_HOOKS, GENERATE_CAPTIONS, GENERATE_VISUAL_BRIEF, etc.
  model      String? // claude-opus-4, gpt-4, claude-sonnet-3-5, etc.
  // NOTE: executionCost NOT included - cost tracking to be added in future PR

  // Reviewer tracking
  reviewerId String   @db.Uuid
  reviewedAt DateTime @default(now())

  // Relations
  approval  ArtifactApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  artifact  Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Analytics indexes
  @@index([workspaceId, reviewedAt(sort: Desc)])
  @@index([provider, decision])
  @@index([capability, decision])
  @@index([feedbackType])
  @@index([severity])
  @@index([executionId])
  @@index([reviewerId])
  @@map("approval_decisions")
}

// ── PR #41: Outcome Attribution Engine ───────────────────────────
// Links artifacts to Meta ads and tracks real business performance.
// Enables provider routing based on actual CTR/CPC/ROAS, not just approval rates.
//
// Flow: Artifact → Approval (APPROVED) → PublishedCreative (Meta ad) → ProviderPerformanceMetrics (CTR/CPC/ROAS)
//
// Query patterns:
// - Published artifacts: WHERE artifactId = ?
// - Ad performance: WHERE metaAdId = ?
// - Provider attribution: JOIN artifacts → publishedCreatives → performanceMetrics WHERE provider = ?
// - Campaign performance: WHERE metaCampaignId = ?

model PublishedCreative {
  id          String @id @default(cuid())
  artifactId  String
  workspaceId String @db.Uuid

  // Meta attribution
  metaAdId       String // Meta ad ID
  metaCampaignId String // Meta campaign ID
  metaAdsetId    String? // Meta adset ID (optional)

  // Publishing metadata
  publishedBy String   @db.Uuid // User who published
  publishedAt DateTime @default(now())

  // Creative metadata
  adName   String? // Meta ad name
  adStatus String? // ACTIVE, PAUSED, ARCHIVED

  // Relations
  artifact           Artifact                     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  performanceMetrics ProviderPerformanceMetrics[]

  @@index([workspaceId, publishedAt(sort: Desc)])
  @@index([artifactId])
  @@index([metaAdId])
  @@index([metaCampaignId])
  @@map("published_creatives")
}

model ProviderPerformanceMetrics {
  id                  String @id @default(cuid())
  publishedCreativeId String
  workspaceId         String @db.Uuid

  // Attribution (denormalized for fast queries)
  provider   String // claude, openai, higgsfield
  capability String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.
  model      String? // claude-opus-4, gpt-4, etc.

  // Meta performance metrics
  impressions Int    @default(0)
  clicks      Int    @default(0)
  ctr         Float? // Click-through rate (clicks / impressions)
  cpc         Float? // Cost per click
  spend       Float  @default(0)
  conversions Int    @default(0)
  revenue     Float  @default(0)
  roas        Float? // Return on ad spend (revenue / spend)

  // Performance period
  startDate DateTime
  endDate   DateTime

  // Data freshness
  fetchedAt DateTime @default(now())

  // Relations
  publishedCreative PublishedCreative @relation(fields: [publishedCreativeId], references: [id], onDelete: Cascade)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([publishedCreativeId, startDate, endDate])
  @@index([workspaceId, fetchedAt(sort: Desc)])
  @@index([publishedCreativeId])
  @@index([provider, capability])
  @@index([startDate, endDate])
  @@map("provider_performance_metrics")
}

model ReinforcementSnapshot {
  id          String  @id @default(cuid())
  workspaceId String? @db.Uuid

  // Provider + Capability (learning is scoped to this pair)
  provider   String // claude, openai, higgsfield
  capability String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.

  // Adaptive scores
  score      Float // Composite score (approval rate, CTR, ROAS, cost efficiency)
  confidence Float // Confidence level (0.0 - 1.0) based on sample size
  sampleSize Int // Number of data points in this snapshot

  // Performance window
  windowStart DateTime
  windowEnd   DateTime

  // Append-only audit trail
  createdAt DateTime @default(now())

  // Relations
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([provider, capability, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([windowStart, windowEnd])
  @@map("reinforcement_snapshots")
}

// ════════════════════════════════════════════════════════════
// PHASE 1 — MARKETING OS DATA SUBSTRATE
// ════════════════════════════════════════════════════════════
// Two interlocking graphs:
//   1. Entity graph:   Account → Campaign → AdSet → Ad → Creative
//   2. Decision graph: Entity → Decision → Outcome → Memory
// Plus a NUMERIC time-series (MetricSnapshot). No metric is ever
// stored as a pre-formatted string — money lives as integer minor
// units + an ISO 4217 currency code, formatted only at the
// presentation layer. See src/lib/money.js.
//
// The new `Campaign` model is the entity-graph node. The new
// `Decision`/`OutcomeSnapshot`/`DecisionMemoryEntry` models are the
// marketing decision graph. The legacy, execution-engine-scoped
// `DecisionMemory` model they used to be contrasted with was removed by
// SC-3 after production measured it at 0 rows; `DecisionMemoryEntry` is a
// DIFFERENT model, mapped to `decision_memory_entries`, and it is live.
// ════════════════════════════════════════════════════════════

// ── Entity graph ─────────────────────────────────────────────

model Account {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String? // platform-native id (e.g. act_98441)
  createdAt   DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  // R9 — DB-level canonical identity. detId(workspaceId, channel, level,
  // externalId) already derives the primary key, but a derivation in application
  // code is not a constraint: any write path that bypassed it could mint a second
  // row for the same platform entity, and nothing would have said so. `level` is
  // absent deliberately — this model IS one level, so it supplies that dimension.
  // NULL externalId does not collide (PostgreSQL indexes are NULLS DISTINCT).
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId])
  @@map("accounts")
}

model Campaign {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  accountId   String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  // Platform campaign objective (Meta OUTCOME_LEADS / OUTCOME_SALES /
  // OUTCOME_AWARENESS / …). Lets the verdict engine distinguish a true awareness
  // campaign from a conversion campaign with no measured revenue. Nullable:
  // pre-fix rows + non-Meta channels have none.
  objective   String?
  // When the campaign was created ON THE PLATFORM (Meta /campaigns
  // `created_time`) — NOT `createdAt`, which is when OUR row was written and is
  // usually the first sync, days or months later. This is the only honest basis
  // for "how long has this been running", which gates the too-early verdict rule.
  // An ENTITY attribute, deliberately not a snapshot column: it never changes, so
  // one row holds it, and a GA4/manual actuals snapshot can never shadow it with
  // a null. Nullable: pre-fix rows and non-Meta channels have none.
  platformCreatedTime DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adSets    AdSet[]

  // R9 — DB-level canonical identity. detId(workspaceId, channel, level,
  // externalId) already derives the primary key, but a derivation in application
  // code is not a constraint: any write path that bypassed it could mint a second
  // row for the same platform entity, and nothing would have said so. `level` is
  // absent deliberately — this model IS one level, so it supplies that dimension.
  // NULL externalId does not collide (PostgreSQL indexes are NULLS DISTINCT).
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId])
  @@index([accountId])
  @@map("campaign_entities")
}

model AdSet {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  campaignId  String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads       Ad[]

  // R9 — DB-level canonical identity. detId(workspaceId, channel, level,
  // externalId) already derives the primary key, but a derivation in application
  // code is not a constraint: any write path that bypassed it could mint a second
  // row for the same platform entity, and nothing would have said so. `level` is
  // absent deliberately — this model IS one level, so it supplies that dimension.
  // NULL externalId does not collide (PostgreSQL indexes are NULLS DISTINCT).
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  adSetId     String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  // When the ad was created ON THE PLATFORM (Meta /ads `created_time`). At this
  // level it is CREATIVE AGE — the natural input to a fatigue trend, which is
  // about how long an audience has been seeing this specific ad, not how long
  // its campaign has existed. Same rule as Campaign.platformCreatedTime:
  // `createdAt` is our own row's write time and is not a substitute.
  platformCreatedTime DateTime?
  createdAt   DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adSet     AdSet      @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creatives Creative[]

  // R9 — DB-level canonical identity. detId(workspaceId, channel, level,
  // externalId) already derives the primary key, but a derivation in application
  // code is not a constraint: any write path that bypassed it could mint a second
  // row for the same platform entity, and nothing would have said so. `level` is
  // absent deliberately — this model IS one level, so it supplies that dimension.
  // NULL externalId does not collide (PostgreSQL indexes are NULLS DISTINCT).
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId])
  @@index([adSetId])
  @@map("ads")
}

model Creative {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  adId        String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)

  // R9 — DB-level canonical identity. detId(workspaceId, channel, level,
  // externalId) already derives the primary key, but a derivation in application
  // code is not a constraint: any write path that bypassed it could mint a second
  // row for the same platform entity, and nothing would have said so. `level` is
  // absent deliberately — this model IS one level, so it supplies that dimension.
  // NULL externalId does not collide (PostgreSQL indexes are NULLS DISTINCT).
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId])
  @@index([adId])
  @@map("creatives")
}

// ── Numeric time-series ──────────────────────────────────────
// Polymorphic: a snapshot attaches to any entity level via
// (entityId, entityLevel) rather than a hard FK. Money fields are
// integer minor units; ratios are floats. `source` is the metric
// origin (may differ from the entity's channel); `granularity` is
// the time grain.

model MetricSnapshot {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  entityId    String      @db.Uuid
  entityLevel EntityLevel
  // The SYNC timestamp — when we wrote this row, NOT the period it measures.
  // Phase C deliberately does not change that meaning; measurementWindow is how
  // a reader learns what the metrics below actually cover.
  date        DateTime
  source      DataSource
  granularity Granularity @default(DAILY)

  // ── Window provenance (Phase C) ────────────────────────────────────────────
  // Required, and deliberately WITHOUT a Prisma default: a writer that forgets
  // it must fail loudly rather than inherit a window it never established.
  // Existing rows were set to LEGACY_UNKNOWN once, by the migration, and are
  // never guessed at again.
  measurementWindow MeasurementWindow
  // The period the row's producer reported, when it reported one. For Meta this
  // is `date_start`/`date_stop` — already requested in CAMPAIGN_INSIGHT_FIELDS
  // and, until now, dropped at normalize. Nullable because a source may state a
  // grain without a period (and every pre-Phase-C row has none): null means
  // "unreported", never a fabricated range.
  windowStart DateTime?
  windowEnd   DateTime?
  // Paid-media windowStart/windowEnd historically contain source-local DATE
  // labels parsed as UTC midnights. They cannot prove UTC instants. Only these
  // new nullable bounds carry a source-timezone-proven spend interval; null
  // leaves all historical and unproven observations UNKNOWN without backfill.
  spendWindowStartUtc DateTime?
  spendWindowEndUtc   DateTime?

  // Money — integer minor units (e.g. piastres, halalas, fils, cents).
  spendMinor   Int  @default(0)
  revenueMinor Int  @default(0)
  cpaMinor     Int?

  // Counters
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)
  // Unique people who saw the ad (Meta /insights `reach`; frequency = impressions
  // ÷ reach). Nullable: pre-column rows and channels that don't report it (Google)
  // have none — stays null, never a fabricated 0.
  reach       Int?

  // Ratios (not money) — plain floats
  ctr       Float?
  roas      Float?
  frequency Float?

  // The FULL funnel, as one generic bag rather than N columns. Meta returns
  // `actions`/`action_values` as an open-ended array of {action_type, value};
  // pinning each stage to its own column means a schema migration every time a
  // platform adds an event. Shape: { purchase, lpv, atc, checkout, lead,
  // videoView, …, purchaseValue, … } — counts plus `${key}Value` for the money
  // side. null (not {}) when the platform reported no recognised action, so a
  // reader can tell "no funnel data" from "a measured zero".
  actionMetrics Json?

  // The entity's configured daily budget at sync time, minor units. Lives on the
  // SNAPSHOT (not the entity) because it changes over time and the series is the
  // point: a >20% step is a Meta learning-phase reset trigger. null when the
  // platform didn't report one (lifetime-budget campaigns, non-Meta channels).
  dailyBudgetMinor Int?

  currency String // ISO 4217 (EGP, SAR, AED, KWD, USD, …)
  // Origin of this observation's denomination. A valid code alone is not proof.
  // Old rows and old writers remain uncertain; never backfill from workspace.
  currencyProvenance String @default("LEGACY_UNKNOWN")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // ── THE WRITE IDENTITY IS NOT DECLARED HERE (B4-E5) ────────────────────────
  //
  // It still exists, and it is still
  //     (entityId, entityLevel, date, granularity, source, measurementWindow)
  // but as of 20260824000000 it is a PARTIAL unique index:
  //
  //     metric_snapshots_non_daily_identity_key
  //       ON (…the six columns…) WHERE "measurementWindow" <> 'DAILY'
  //
  // Prisma's schema language cannot express an index predicate, so there is no
  // faithful `@@unique` to write. A full `@@unique` would be a lie in the one
  // direction that matters: `prisma migrate diff` reads it as drift and emits
  // `CREATE UNIQUE INDEX "metric_snapshots_identity_key"` — measured, not
  // assumed — so keeping it for the sake of the generated types would hand the
  // next `migrate dev` a migration that silently re-breaks DAILY.
  //
  // WHY PARTIAL. `date` above is the SYNC timestamp. One sync stamps ONE instant
  // across a whole run, so seven days of one campaign arrive with seven periods
  // and one identical `date`, differing only in `windowStart` — which cannot
  // join the key because it is nullable, and NULL <> NULL inside a unique index
  // would silently stop de-duplicating GA4, MANUAL, Google and every legacy row.
  // The key is right for populations that report a trailing aggregate and wrong
  // for the one that reports a day, so the day was released from it instead.
  //
  // The consequences of removing the declaration, both deliberate:
  //   · the generated compound-key selector is gone. Nothing used it — B4-E4
  //     moved the last three writers onto upsertNonDailyMetricSnapshot, whose
  //     raw statement carries the predicate PostgreSQL needs to match a partial
  //     index. Restoring `@@unique` here would not restore that path.
  //   · DAILY has no database-level uniqueness. Its identity is
  //     (workspaceId, entityId, entityLevel, source, windowStart) and is
  //     enforced by dailySnapshotSink's read-then-write. That residual is
  //     documented at the head of that file; it pre-dates this change.
  @@index([workspaceId, entityId, entityLevel, date])
  @@index([entityId, date])
  @@map("metric_snapshots")
}

// ── Decision graph: Entity → Decision → Outcome → Memory ─────
// This is what makes Lumi an operating system rather than a
// dashboard. Phase 1 scaffolds the schema + contracts; feature
// logic lands in later phases.

// The four states a Decision can hold. EXECUTED and DISMISSED have no writer
// today, but DecisionAccuracyService QUERIES both — an enum without them makes
// Prisma throw on those reads, no matching row required.
// C-05 — WHY a guardrail episode ended. `RESOLVED + resolvedAt + openHitKey
// null` describes two different events, and the row is all a later reader gets:
//
//   CONDITION_CLEARED — a sweep judged the pair and found no breach. The only
//                       ending that says anything about the account.
//   RULE_REVOKED      — a person withdrew the rule's authority. Nothing judged
//                       the breach to have ended; we stopped asking.
//
// null is neither. It is a row written before this column existed, and it is
// never read as "cleared" — which is exactly why the natural closer states its
// reason explicitly instead of letting absence stand in for it.
enum DecisionClosureReason {
  CONDITION_CLEARED
  RULE_REVOKED
}

// C-10 — WHAT KIND of decision a row is. Five writers share this table and the
// kind used to be a string prefix on `rootCause`, owned privately by each of
// them; three separate consumers had written their own parser to recover it.
//
// Mirrors DECISION_CLASS in @marcom/runtime-contracts — that module is the
// contract and carries the reasoning; this is the storage side of it.
//
// ALLOCATION is here because AllocationService writes Decision rows TODAY.
// Whether a REALLOCATE proposal belongs in this table at all is a real and
// separate architectural question; leaving the class off would make the column
// NULL for a producer we know exactly, which is a different and false claim.
enum DecisionClass {
  SIGNAL
  GUARDRAIL
  ALLOCATION
  EXPERIMENT
}

// C-16 (R-6) — what a Decision knew about this account's validated history at
// the moment it was committed. The first three values already existed in
// `institutionalMemory.js` and are mirrored here so the column can carry them;
// NOT_CONSULTED is the state every Decision written before C-16 is in, because
// the write path never asked. It is deliberately a value rather than a NULL:
// a null would have to be READ as "not consulted", and R-4 forbids deriving a
// state from the shape of the data.
enum MemoryStatus {
  OK
  NO_VALIDATED_MEMORY
  MEMORY_UNAVAILABLE
  NOT_CONSULTED
}

enum DecisionStatus {
  PROPOSED
  EXECUTED
  DISMISSED
  SUPERSEDED
  // C-02 — the condition a decision was raised about ended, with no human act.
  // None of the other four can say that. SUPERSEDED means a NEWER VERDICT
  // replaced this one and is written only by VerdictService over its own scope;
  // EXECUTED and DISMISSED are claims a person made; PROPOSED would leave the
  // row in every open query forever, which is the accumulation R-3 named.
  //
  // A guardrail episode closes here: a sweep that evaluated the rule against the
  // entity found no breach. Never written from a sweep that merely stopped
  // looking — see GUARDRAIL_OUTCOME in guardrailEngine.js.
  RESOLVED
}

// How the entity behaved between a verdict being issued and being replaced.
// UNKNOWN is a real answer, not a gap-filler: it is what a decision with no
// metrics on either end honestly resolves to.
enum DecisionResolution {
  IMPROVED
  UNCHANGED
  WORSENED
  UNKNOWN
}

// R13 — the operator's judgement of a verdict. Three answers to "what did you
// decide?", never to "was Lumi wrong?": the second framing invites grading an
// oracle, and what the loop actually needs is what the human chose.
enum HumanDecisionResponse {
  CONFIRM // agrees with the recommendation
  OVERRIDE // deliberately chose a different action
  ADJUST // kept the direction, changed the magnitude or scope
}

// Why. A CLOSED vocabulary, because this is the durable learning signal and a
// free-text field cannot be aggregated across accounts without inventing
// meaning. The note beside it carries the specifics; this carries the class.
// OTHER is a real answer, not a gap-filler — an operator whose reason is not
// listed must be able to say so rather than pick a nearby lie.
enum HumanDecisionReason {
  OBJECTIVE_CONTEXT
  BUSINESS_CONSTRAINT
  TOF_ROLE
  BRAND_ROLE
  SEASONALITY
  DATA_CONTEXT
  TESTING_INTENT
  RISK_TOLERANCE
  OTHER
}

model Decision {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  entityId    String         @db.Uuid
  entityLevel EntityLevel
  verdict     Verdict
  // C-16 — NULLABLE. null means the engine produced no confidence for this
  // call: "we did not measure this", which is exactly what baseConfidence
  // records beside it.
  //
  // It used to be NOT NULL, and the writer satisfied that with `?? 0.5` — an
  // invented coin flip on the one row R-6 exists to make auditable, and the
  // same fabrication I54 removed from the pattern engine. Dropping NOT NULL is
  // what let the fabrication go: no production path produces a null today
  // (every finalise() passes an explicit number, and persistLevelVerdicts has
  // no production callers), so this widens what the column ACCEPTS without
  // changing what it holds.
  confidence  Float? // 0.0 – 1.0, or null when nothing was measured
  diagnosis   String
  rootCause   String?
  status      DecisionStatus @default(PROPOSED)

  // ── C-10 · the CANONICAL semantic identity of this row ─────────────────────
  // Which of the five writers authored it, and therefore which questions its
  // `verdict` can answer. `rootCause` keeps explanation / subtype / provenance
  // — it is no longer where the kind is stored, and no consumer parses it to
  // recover one.
  //
  //     A verdict may only be interpreted within the decision class that gives
  //     that verdict its meaning. SIGNAL KILL ≠ GUARDRAIL KILL.
  //
  // NULLABLE, AND PERMANENTLY SO. NULL means UNCLASSIFIED — a row written
  // before this column whose `rootCause` names an enum value since deleted from
  // the code. It is never a fifth class and never a synonym for any of the four.
  // Deliberately NO `@default`: a default would let a future writer claim a
  // class it never declared, which is exactly what the writer contract forbids.
  decisionClass DecisionClass?

  // ── C-16 (R-6) · the memory that shaped this call, frozen at commitment ────
  // Three facts, and they are a MEASUREMENT rather than a reference.
  //
  // `AccountPattern` is upserted in place and `dynamicFields` rewrites nine of
  // its columns every sweep — including `statement`, the sentence itself. So a
  // stored patternId dereferenced six months from now would yield TODAY's
  // wording and TODAY's accuracy: an audit trail that looks correct and lies.
  // `ctrAtDecision` / `roasAtDecision` exist for exactly this reason, because
  // MetricSnapshot is re-stamped per sync. Same argument, one object over.
  //
  // `confidence` above is now the PUBLISHED figure — what the operator was
  // actually shown. `baseConfidence` keeps the engine's own, so the adjustment
  // is always recoverable and the deterministic number is never lost. Before
  // C-16 the two sides of one sweep disagreed silently: the read published
  // base × memoryFactor while the writer stored base.
  //
  // All three NULLABLE and permanently so. A row written before this column
  // carries NOT_CONSULTED, which is the truth about it.
  baseConfidence   Float?
  memoryStatus     MemoryStatus?
  memoryProvenance Json?

  // ── Lifecycle ──────────────────────────────────────────────
  // Three moments, each set ONCE and never overwritten: a second click is not a
  // second engagement, and re-stamping would turn "when did they first look at
  // this" into "when did they last click", which answers a different question.
  explainedAt DateTime? // first time a human opened the reasoning
  intentAt    DateTime? // first time they copied it or opened the ad platform
  // The two HUMAN signals, mutually exclusive: an operator said they acted on
  // this call, or that they rejected it. Distinct from intentAt, which only
  // means "took it somewhere they could act" and is what decisionLearning leans
  // on for that weaker claim. Deliberately timestamps rather than a `status`
  // move: see the migration for the four readers that gate on PROPOSED.
  // ── R13-D / B4-A — execution provenance is TWO facts, never one ──────────
  //
  // `executedAt` carried both of these at once and nothing could tell them
  // apart. Before B3 that was harmless: `execution_requests` was empty, so
  // every value was a self-report and the column had one meaning. B3 wired the
  // real producer and gave it a second writer, at which point the same column
  // meant "a human says they acted" on some rows and "Meta accepted a mutation"
  // on others — with no discriminator, and no consumer joining to
  // ExecutionRequest to recover one.
  //
  // A human self-report is NOT evidence that Lumi executed anything. Any claim
  // about Lumi's platform performance must read `platformExecutedAt` alone.
  //
  // Both may be set on one decision: an operator can act by hand and later run
  // it through Lumi, or the reverse. They are independent facts, so neither
  // write clears the other. Questions of the form "was this acted on at all"
  // take the union through decisionProvenance.interventionAt() — explicitly,
  // at a named seam, never by reaching for whichever column is nearer.
  humanExecutedAt    DateTime? // the operator reported acting themselves
  platformExecutedAt DateTime? // the canonical worker landed a real mutation

  // DEPRECATED (B4-A). No code reads or writes this column any more; the two
  // above replace it, and a migration copied every existing value into
  // `humanExecutedAt` (safe because production held zero execution_requests, so
  // no value here was ever a platform stamp).
  //
  // KEPT, not dropped: dropping a column is irreversible and this database is
  // known to sit ahead of its migration history. API responses still publish an
  // `executedAt` field for already-shipped clients, but it is DERIVED at read
  // time from the two columns above — it is no longer this column. Removing it
  // is a follow-up slice once the derived alias is confirmed unused.
  executedAt  DateTime?
  dismissedAt DateTime?
  resolvedAt  DateTime? // SYSTEM signal: when a new verdict replaced this one

  resolution      DecisionResolution? // null until resolved
  confidenceDelta Float? // CTR delta (percentage POINTS) between issue and resolution

  // ── R13 — what the HUMAN decided, kept beside what Lumi decided ──────────
  // A THIRD axis, independent of the two above. executedAt/dismissedAt record
  // what happened on the ad platform; `verdict` records what Lumi believed;
  // these record the operator's judgement of that belief. All three are facts
  // about different things, so none of them overwrites another — in particular
  // an OVERRIDE never rewrites `verdict`, because "Lumi said KILL" stays true
  // even when the buyer keeps the campaign. Two independent records, not one
  // corrected one.
  //
  // OVERRIDE is NOT dismissal. A buyer who overrides a KILL and keeps running
  // the campaign leaves executedAt and dismissedAt both null — accurate, and
  // deliberately left for R14 to reconcile with the accuracy surface.
  //
  // All nullable and permanently so: null means NO JUDGEMENT WAS RECORDED, and
  // must never be read as CONFIRM or filled with OTHER. The absence of an
  // opinion is not an opinion.
  humanResponse    HumanDecisionResponse?
  humanReasonCode  HumanDecisionReason? // required by the route for OVERRIDE/ADJUST
  humanReasonNote  String? // free text; context, never the learning signal
  humanRespondedAt DateTime? // first judgement only — see the route's first-write-wins

  // Metrics as they stood WHEN THE VERDICT WAS ISSUED. Stamped here because a
  // MetricSnapshot is a rolling per-sync aggregate re-stamped every sweep — it
  // cannot be read backwards to reconstruct a past state. Without these there is
  // no "before" to compare against, and resolution is not computable at all.
  //
  // ctrAtDecision is a PERCENT (1.64 = 1.64%), matching verdictEngine's
  // signalInput.ctr — NOT the 0..1 ratio MetricSnapshot.ctr carries.
  ctrAtDecision  Float?
  roasAtDecision Float? // null when revenue was never measured (never a fabricated 0)

  // ── Similarity key ─────────────────────────────────────────
  // What makes two decisions comparable, alongside verdict + rootCause +
  // entityLevel (already above). Both are String?, not enums: a Decision is a
  // historical record, and pinning it to a live enum would let a future enum
  // change rewrite what a past decision claims about itself. Null on every row
  // written before these existed — never backfilled from the entity's CURRENT
  // channel, which would assert something about the past nobody recorded.
  objective String?
  channel   String? // the Channel enum's own string, so a join to Campaign lines up

  // ── Reasoning snapshot ─────────────────────────────────────
  // What the engine BELIEVED when it made this call, captured once at creation
  // and never touched again — resolvePrevious closes a row out without going
  // near these. A verdict that was right for a reason we no longer have on file
  // teaches nothing, and `rootCause` alone only names the winner.
  //
  // JSONB = STORAGE, NOT SEARCH. Nothing queries into these and nothing should:
  // the shape is the engine's own reasoning taxonomy, and normalising it would
  // freeze that taxonomy against a schema unable to follow it. A future learning
  // query that needs to filter by mechanism gets an extracted, indexed column
  // derived from this — the snapshot stays the immutable record.
  //
  // NULL vs []: null is "never captured" (every row before this migration); []
  // is "the engine ran and produced none", which an early-gate decision under
  // 1 000 impressions genuinely does. Different facts, kept apart.
  hypotheses      Json? // [{ id, labelKey, source, supports[], contradicts[], observed[], confidence }]
  counterfactuals Json? // [{ mechanism, labelKey, rejectedBy[], preferredBecause[], confidence }]

  // ── Evidence reference (R5 / I18) ──────────────────────────
  // WHAT EVIDENCE PRODUCED THIS ROW. The three columns above record what the
  // engine BELIEVED; this one records what it was LOOKING AT — the population,
  // the measurement window those rows represent, the source(s) and observation
  // timestamp(s) that actually contributed, how many rows were consumed, and the
  // named rule that reduced them to the numbers beside it.
  //
  // NOT a copy of the evidence. The values that mattered are already frozen in
  // ctrAtDecision/roasAtDecision and hypotheses[].observed[]; duplicating the
  // rows would create a second copy of the truth, which reasoningArtifact.js
  // already refused once. This is identity and CONTEXT beside them — which is
  // also why a bare snapshot id would not do: snapshots are upserted, so a uuid
  // is not proof that what it points at still says what it said.
  //
  // Same JSONB rule as its neighbours: STORAGE, NOT SEARCH. Written once at
  // create, never rewritten — resolvePrevious closes a row out without going
  // near it.
  //
  // NULL vs a stored reference with `refs: []`: null is "never captured" (every
  // pre-R5 row, and any writer that cannot establish provenance honestly); a
  // stored reference always describes a real read. Never backfilled.
  evidenceReference Json? // { population, selector, measurementWindow, sources, observedAt, reduction, entityIds, rowCount, refs }

  // ── C-02 · guardrail hit identity ──────────────────────────────────────────
  // The STABLE rule id. `rootCause` carries `guardrail:<rule.name>`, and a name
  // is mutable, so it can never identify anything — the sweep has had
  // `hit.ruleId` in hand all along and discarded it for the display string.
  //
  // Deliberately NOT a relation. A hit must stay identifiable after its rule is
  // deleted; an FK would either null this out (destroying the identity of every
  // historical hit) or block the deletion. Same reasoning and same shape as
  // AccountPattern.promotedRuleId.
  //
  // NULL on every non-guardrail Decision, and on guardrail rows written before
  // this column existed — those cannot be back-filled, because resolving their
  // mutable name to a rule today would be inventing an identity.
  guardrailRuleId String? @db.Uuid
  // `<ruleId>:<entityId>:<entityLevel>` while the breach episode is OPEN, NULL
  // once it closes. PostgreSQL exempts NULL from unique constraints, so any
  // number of closed episodes coexist while at most one may be open per
  // (rule, entity) — deduplication enforced by the database rather than by a
  // query a later edit could quietly widen.
  openHitKey String?
  // C-05 — why the episode above ended. Written by both closers, so that NULL
  // means "written before this column existed" and never "the condition
  // cleared". Deliberately NOT `resolution`: that column is half of the
  // learning predicate, and an administrative closure is not an outcome.
  closureReason DecisionClosureReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outcomes  OutcomeSnapshot[]
  memories  DecisionMemoryEntry[]
  tests     TestExperiment[]
  // R10 (I55) — the platform executions this call produced. A Decision can own
  // several: a retry mints a fresh ExecutionRequest, and one verdict can be
  // acted on at more than one target. `executedAt` is still stamped by the
  // FIRST success only (see executionWorker) — it records when the operator
  // first acted, not how many times.
  executions ExecutionRequest[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityId, entityLevel])
  // Both indexes below are PARTIAL in SQL and plain here: Prisma cannot express
  // a WHERE clause on @@index, so they are hand-written in the migrations. The
  // predicate is the point of them — do not "reconcile" it away.
  //
  // R12-1c correction: an earlier note here claimed `migrate diff` treats the
  // plain and partial forms as equivalent. It does not. The diff proposes
  // creating a plain duplicate of each, which is how a redundant full-table
  // index nearly got added alongside a smaller partial one that already serves
  // the query. The deployed objects were confirmed against production.
  //
  // Deployed as decisions_verdict_resolution_idx — the name Prisma would
  // generate anyway, so no map is needed:
  //   ... (verdict, resolution) WHERE resolution IS NOT NULL
  @@index([verdict, resolution])

  // B4-A — the two population reads that replaced `executedAt IS NOT NULL`
  // (accuracy population, pending-outcomes queue). Same treatment as the index
  // above: deployed as PARTIAL (`WHERE ... IS NOT NULL`) under exactly the name
  // Prisma generates for these declarations, so the migration's CREATE INDEX IF
  // NOT EXISTS wins and no full-table duplicate is ever added beside it.
  @@index([workspaceId, humanExecutedAt])
  @@index([workspaceId, platformExecutedAt])
  // Deployed as decisions_similarity_idx (20260731000000), which is NOT the
  // name Prisma generates. `map:` pins the declaration to the object that is
  // actually deployed rather than asking production to be renamed to suit the
  // generator. C1 (20260820100000) REPLACED its predicate in place — same name,
  // same key, new WHERE — because the learning population it serves stopped
  // being "engaged with" and became "intervened on":
  //   ... (workspaceId, verdict, rootCause, channel)
  //   WHERE resolution IS NOT NULL
  //     AND ("humanExecutedAt" IS NOT NULL OR "platformExecutedAt" IS NOT NULL)

  @@index([workspaceId, verdict, rootCause, channel], map: "decisions_similarity_idx")

  // C-02 — at most one OPEN guardrail episode per (rule, entity) per workspace.
  // Closed episodes carry NULL and are exempt, so a breach that returns opens a
  // genuinely new row rather than reviving a dead one.
  @@unique([workspaceId, openHitKey])
  // Answers "what has this rule caught" as a join on a stable id (C-14), which
  // is today attempted as a match on a display name.
  @@index([workspaceId, guardrailRuleId])
  // C-10 — the pair every scoped population read now carries. Eight readers ask
  // for SIGNAL alone and four for GUARDRAIL alone, each within one workspace.
  @@index([workspaceId, decisionClass])
  @@map("decisions")
}

model OutcomeSnapshot {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  decisionId  String      @db.Uuid
  entityId    String      @db.Uuid
  entityLevel EntityLevel

  // Realized result of acting on the decision (minor units).
  spendDeltaMinor   Int?
  revenueDeltaMinor Int?
  roasDelta         Float?

  windowStart DateTime?
  windowEnd   DateTime?
  sustained   Boolean? // did the lift hold?
  createdAt   DateTime  @default(now())

  // R6 (I19) — a recorded outcome must be able to name what it measured, and
  // must not change after the fact.
  //
  // measuredAt: when the operator ESTABLISHED the result. Deliberately not
  // createdAt (when the row was written), not executedAt (when they acted), and
  // not observedAt (which belongs to the evidence rows). Nullable for the rows
  // recorded before R6 — an unrecorded fact stays unrecorded, never backfilled.
  measuredAt DateTime?

  // The evidence Lumi holds for the entity over the measured period. Same shape
  // as Decision.evidenceReference and a DIFFERENT question: that one describes
  // what the decision was made from, this one what the outcome was measured
  // against. Storage, not search — nothing queries into it.
  evidenceReference Json?

  // Supersession, not overwrite. Re-recording CREATES a new row; the previous
  // one keeps its values, its provenance and its measuredAt, and gains only the
  // two columns that say it is no longer current. `supersededAt IS NULL` is the
  // definition of the current outcome (outcomeSelection.js owns it).
  supersededAt   DateTime?
  supersededById String?   @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([decisionId])
  // The current-outcome read: one decision's non-superseded row.
  @@index([decisionId, supersededAt])
  @@map("outcome_snapshots")
}

model DecisionMemoryEntry {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  decisionId        String?  @db.Uuid
  entityId          String?  @db.Uuid
  actionType        String?
  rationale         String
  isSustainable     Boolean?
  impactDurationHrs Int?
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([decisionId])
  @@map("decision_memory_entries")
}

// ════════════════════════════════════════════════════════════
// PHASE 2 — PREDICTIVE + GUARDRAILS
// ════════════════════════════════════════════════════════════

// Forward-looking creative-fatigue forecast for an entity. Written
// each sweep; on resolution (actual breach or REFRESH executed) a
// DecisionMemoryEntry is written capturing predicted-vs-actual.
model FatiguePrediction {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @db.Uuid
  entityId            String      @db.Uuid
  entityLevel         EntityLevel
  metric              String      @default("frequency") // signal that will breach
  ceiling             Float // breach threshold (e.g. 3.5)
  projectedBreachDate DateTime
  confidence          Float // 0.0 – 1.0
  basis               String? // short human-readable basis of the projection
  createdAt           DateTime    @default(now())

  // Resolution (set when the forecast is confirmed or invalidated)
  resolvedAt       DateTime?
  actualBreachDate DateTime?
  accuracy         Float? // |projected - actual| scored 0..1 at resolution

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityId, entityLevel])
  @@index([resolvedAt])
  @@map("fatigue_predictions")
}

// User-defined recurring rule Lumi enforces each sweep. Hits produce
// radar verdicts (Decisions, status PROPOSED) — never auto-execution.
model GuardrailRule {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @db.Uuid
  name          String
  enabled       Boolean       @default(true)
  scopeLevel    EntityLevel   @default(ADSET)
  audienceTag   String? // optional filter, e.g. "cold"
  metric        String // e.g. "cpaOverTargetPct", "frequency", "roas"
  comparator    Comparator
  threshold     Float // interpreted per `unit`
  unit          ThresholdUnit @default(RATIO)
  sustainedDays Int           @default(1)
  emitVerdict   Verdict       @default(WATCH)

  // C-05 · provenance. The pattern this rule was promoted from — IDENTITY, not
  // belief. `AccountPattern` is upserted in place (R-6), so this says which
  // learning produced the rule and nothing about what that learning claimed at
  // the time; the frozen claim lives in the AUTONOMY_GRANTED event. Plain
  // column rather than a relation, same reasoning as Decision.guardrailRuleId.
  // NULL on a hand-authored rule and on every rule promoted before C-05.
  sourcePatternId String? @db.Uuid
  // When a person withdrew this rule's authority. `enabled` is the state the
  // sweep reads; this is the fact that explains it, so "revoked" can never be
  // inferred from a switch that anything else might also flip.
  revokedAt DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@index([sourcePatternId])
  @@map("guardrail_rules")
}

// ════════════════════════════════════════════════════════════
// PHASE 3 — CAPITAL ALLOCATION
// ════════════════════════════════════════════════════════════

// A proposed cross-channel budget distribution toward a goal, built on
// BLENDED truth (not platform claims). The container persists the goal,
// budget, projected blended impact, and the reasoning trail; each
// individual move is a PROPOSED REALLOCATE Decision linked back via
// `Decision.rootCause = "allocation:<planId>"`, so reallocations flow
// through the existing confirm→execute governance + audit. Never
// auto-executes.
model AllocationPlan {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  goalType         GoalType
  goalValue        Float? // interpretation depends on goalType (null for GROWTH_CEILING)
  totalBudgetMinor Int // the spend ceiling, integer minor units
  currency         String   @default("USD")

  // Projected blended impact (minor units / ratios).
  projectedRoas     Float?
  projectedCpaMinor Int?
  merBefore                         Float? // legacy-only projected efficiency; never written by new blended-efficiency plans
  merAfter                          Float? // legacy-only projected efficiency; never written by new blended-efficiency plans
  blendedRevenueEfficiencyBefore    Float? // selected Blended Truth revenue / compatible paid-media spend
  blendedRevenueEfficiencyAfter     Float? // projected selected revenue / projected paid-media spend

  reasoning String // newline-joined reasoning trail
  status    AllocationStatus @default(PROPOSED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("allocation_plans")
}

// ════════════════════════════════════════════════════════════
// PHASE 4 — TESTING OS (closed-loop weekly experiments)
// ════════════════════════════════════════════════════════════

// A single weekly experiment across one of the four testing dimensions.
// Proposed by the generator, run by the buyer, and CONCLUDED by the
// readout — which writes the outcome to Decision Memory and (when the
// winner is confident + governance-valid) links a REFRESH/SCALE Decision.
model TestExperiment {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  entityId    String?      @db.Uuid // the campaign/adset the test runs on
  entityLevel EntityLevel?

  dimension      TestDimension
  hypothesis     String
  metric         String // the watched signal: CTR | CVR | ROAS | CPA
  expectedSignal String
  priority       Float         @default(0)
  status         TestStatus    @default(PROPOSED)
  currency       String        @default("USD")

  startedAt   DateTime?
  concludedAt DateTime?

  // Readout (set at conclusion).
  winnerLabel     String?
  lift            Float? // % improvement of winner vs control
  confidence      Float?
  confidenceLabel String? // HIGH | MODERATE | LOW | INCONCLUSIVE
  sampleNote      String?

  // The verdict Decision this test produced (null until/unless a
  // confident, governance-valid winner emerges).
  decisionId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  variants  TestVariant[]

  // Holdouts promoted from this concluded test (the Phase-7C bridge).
  incrementalityTests IncrementalityTest[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([entityId, entityLevel])
  @@map("test_experiments")
}

// One arm of a test (control or challenger). Carries the raw counts the
// readout engine reads — refreshed live from Meta Insights on conclude,
// or recorded manually for the demo/CI path.
model TestVariant {
  id          String  @id @default(uuid()) @db.Uuid
  testId      String  @db.Uuid
  label       String // "A", "B", "Hook A", …
  description String  @default("")
  isControl   Boolean @default(false)

  // Maps the arm to its Meta entity so insights can be pulled live.
  metaEntityId String?
  metaLevel    String? // AD | ADSET

  // Performance counts (money in integer minor units).
  impressions  Int     @default(0)
  clicks       Int     @default(0)
  conversions  Int     @default(0)
  spendMinor   Int     @default(0)
  revenueMinor Int     @default(0)
  isWinner     Boolean @default(false)

  createdAt DateTime @default(now())

  test TestExperiment @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("test_variants")
}

// ════════════════════════════════════════════════════════════
// PHASE 5 — MEMORY MOAT (per-account learning → playbooks)
// ════════════════════════════════════════════════════════════

// A durable pattern Lumi has learned about ONE account, mined from its own
// Decisions/Outcomes/Tests/MetricSnapshots. Confidence is truth-weighted
// (recency-weighted accuracy × support), not a raw count. A promotable
// pattern carries an executable guardrail spec; a SUPERSEDED/CONFLICTED
// pattern (conflict resolution) is never promoted.
model AccountPattern {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  patternKey  String // deterministic engine key — stable across re-extractions
  kind        PatternKind
  statement   String
  basis       String?

  // Truth, not just volume.
  support          Int           @default(1) // raw occurrence count
  effectiveSupport Float         @default(0) // recency-weighted support
  accuracy         Float? // recency-weighted "was Lumi right?" (null until known outcomes)
  // R10 (I54) — NULLABLE. Confidence here is derived from `accuracy`, so a
  // pattern with no measured outcome has no confidence to state. It used to be
  // computed from an invented 0.5 prior and rendered as a percentage, which made
  // "never checked" indistinguishable from "checked and it was a coin flip".
  // null is the honest value and every reader already handles it (the promotion
  // gate, scenario and network all require `accuracy != null` first).
  confidence       Float?
  status           PatternStatus

  // Promotable guardrail spec (null for informational kinds).
  metric        String?
  scopeLevel    EntityLevel?
  audienceTag   String?
  comparator    Comparator?
  threshold     Float?
  unit          ThresholdUnit?
  emitVerdict   Verdict?
  sustainedDays Int?

  // Conflict resolution + promotion provenance.
  supersededById String? @db.Uuid
  promotedRuleId String? @db.Uuid

  firstObservedAt DateTime
  lastObservedAt  DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  observations PatternObservation[]
  supersededBy AccountPattern?      @relation("PatternSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   AccountPattern[]     @relation("PatternSupersede")

  @@unique([workspaceId, patternKey])
  @@index([workspaceId, status])
  @@map("account_patterns")
}

// The accuracy audit trail — one row per pattern occurrence, recording
// what Lumi predicted vs what actually happened. This is what lets the
// memory answer "was Lumi right?" and decay stale evidence by date.
model PatternObservation {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  patternId     String   @db.Uuid
  decisionId    String?  @db.Uuid
  entityId      String?  @db.Uuid
  occurrenceKey String // stable dedup key so re-extraction never double-counts
  predicted     String
  actual        String?
  correct       Boolean?
  observedAt    DateTime
  createdAt     DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pattern   AccountPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, occurrenceKey])
  @@index([workspaceId, observedAt])
  @@map("pattern_observations")
}

// ════════════════════════════════════════════════════════════
// Phase 6 — Planning OS
// ════════════════════════════════════════════════════════════

// Per-workspace unit economics the strategist sets once and edits. Feeds
// the unit-economics engine (LTV / payback / contribution margin) AND the
// scenario engine's revenue/gross-profit outputs. AOV is seeded from
// blended truth when unset. Money in integer minor units.
model AccountEconomics {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @unique @db.Uuid
  currency             String   @default("USD")
  aovMinor             Int // average order value, minor units
  grossMarginPct       Float // gross margin as a ratio [0,1]
  repeatRate           Float    @default(0) // informational; folds into avgOrders
  avgOrdersPerCustomer Float    @default(1) // lifetime orders per customer
  targetLtvToCac       Float    @default(3) // sustainability target
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("account_economics")
}

// A quarterly north-star: e.g. "blended CAC ≤ X at Y spend". The
// goal-tracker engine projects a trend-based landing ESTIMATE (a range)
// and folds in leading fatigue signals. Optionally linked to the Plan it
// belongs to.
model NorthStarGoal {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  name              String
  metric            String // e.g. "blendedCac", "blendedRoas", "mer"
  comparator        Comparator // GTE for ROAS, LTE for CAC, …
  targetValue       Float
  spendCeilingMinor Int? // the "at Y spend" half of the target
  currency          String     @default("USD")
  periodStart       DateTime
  periodEnd         DateTime
  status            GoalStatus @default(ON_TRACK)
  trackingUnavailableReason String?
  planId            String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("north_star_goals")
}

// A forward-looking plan: assembled budget + channel mix + testing agenda
// + projections, all snapshotted as JSON. `memoryBasis` records WHICH
// Phase-5 patterns the plan leaned on (traceability — "why did Lumi
// suggest this?"). The mix promotes to PROPOSED REALLOCATE Decisions via
// the existing Phase-3 governance (allocationPlanId set on promote) — no
// new execution code.
model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  workspaceId      String         @db.Uuid
  name             String
  periodStart      DateTime
  periodEnd        DateTime
  totalBudgetMinor Int
  currency         String         @default("USD")
  status           PlanStatus     @default(DRAFT)
  channelMix       Json // snapshot of the allocation preview
  testingAgenda    Json // snapshot of the Phase-4 weekly agenda
  projections      Json // scenario + econ + landing ranges, with assumptions
  memoryBasis      Json // [{ patternId, kind, statement, accuracy }] — "Powered by Memory"
  allocationPlanId String?        @db.Uuid // set when the mix is promoted (Phase-3 loop)
  // ── C-18: the promotion, and the end of the lifecycle ─────────
  // `createdAt` is when someone BUILT this plan; it says nothing about whether
  // the plan was ever put into force, and the loop-health surface was reading it
  // as if it did. These three record the two transitions that actually happen.
  //
  // `promotedAt` is also the idempotency key. `allocationPlanId` cannot be: an
  // approved mix that matches current spend is promoted with no moves, so it
  // writes no AllocationPlan and would be promotable a second time.
  //
  // `closedAt` records that a period ENDED. It is written by a scheduled sweep
  // and carries no claim about what was learned — GoalStatus.ACHIEVED/MISSED and
  // AllocationStatus.ACCEPTED/REJECTED still have no writer, and need a producer
  // that owns evidence rather than a clock (Invariant 13).
  promotedAt       DateTime?
  promotedBy       String?        @db.Uuid // User.id — never the Firebase uid
  closedAt         DateTime?
  // ── Phase 8: approval gate (opt-in per plan) ──────────────────
  // When requiresApproval, a buyer cannot promote/execute the plan until a
  // strategist signs off; approvalState tracks that PENDING→APPROVED gate.
  requiresApproval Boolean        @default(false)
  approvalState    ApprovalState?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goals     NorthStarGoal[]
  approvals ApprovalRequest[]

  @@index([workspaceId, status])
  // C-18 — the closure sweep runs globally, so the workspace-scoped index above
  // cannot serve it.
  @@index([status, periodEnd])
  @@map("plans")
}

// ════════════════════════════════════════════════════════════
// PHASE 7 — MEASUREMENT OS (attribution · incrementality)
// ════════════════════════════════════════════════════════════

// A holdout/incrementality experiment — the only CAUSAL measurement we
// run. Designed via a power calc, read out as a lift with a CONFIDENCE
// INTERVAL (never a point), and written to Decision Memory on conclude
// (mirrors the Phase-4 test loop). Money in integer minor units.
model IncrementalityTest {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String
  channel     String // e.g. "META" — the channel being held out
  entityId    String?      @db.Uuid
  entityLevel EntityLevel?

  // Provenance: the concluded A/B test this holdout was promoted from (the
  // Phase-7C bridge). Null for holdouts designed directly. SetNull on delete —
  // losing the source test never invalidates a running causal experiment.
  sourceTestId String?         @db.Uuid
  sourceTest   TestExperiment? @relation(fields: [sourceTestId], references: [id], onDelete: SetNull)

  // Design (from the power calc).
  holdoutPct       Float
  mde              Float // minimum detectable (relative) lift
  sampleSizePerArm Int
  durationDays     Int
  guardrails       Json

  status IncrementalityStatus @default(DESIGNED)

  // Observed counters (filled as the holdout runs).
  exposedUsers       Int @default(0)
  exposedConversions Int @default(0)
  holdoutUsers       Int @default(0)
  holdoutConversions Int @default(0)

  // Readout (causal lift + CI). Null until CONCLUDED.
  liftPct                 Float?
  ciLow                   Float?
  ciHigh                  Float?
  confidenceLabel         ConfidenceLevel?
  incrementalRevenueMinor Int?
  decisionId              String?          @db.Uuid // optional PROPOSED Decision on a confident result

  startedAt   DateTime?
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("incrementality_tests")
}

// The ingestion table that makes multi-touch attribution honest WHEN it is
// populated. Empty until a path/journey source (GA4 path export, etc.) is
// connected — until then the path-based attribution models honestly return
// INSUFFICIENT_DATA rather than invent journey credit.
model PathTouch {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  conversionId      String // groups touches into one conversion journey
  channel           String
  entityId          String?  @db.Uuid
  touchPosition     Int // 0-based order within the journey
  occurredAt        DateTime
  isConversionTouch Boolean  @default(false)
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversionId, touchPosition])
  @@map("path_touches")
}

// ════════════════════════════════════════════════════════════
// PHASE 8 — COLLABORATION & REPORTING OS
// ════════════════════════════════════════════════════════════

// A persisted, auto-generated stakeholder narrative — reasoned prose, NOT a
// dashboard. `body` holds the sections+claims+figures; EVERY figure carries an
// evidenceRef (a real row id) so nothing is hallucinated. `confidenceScore` +
// `confidenceBasis` keep the report-confidence itself auditable at rest (never
// a bare %). Leadership needs the durable weekly/monthly record, so these are
// persisted (alerts, by contrast, are routed live — no table).
model StakeholderNarrative {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  period          NarrativePeriod
  audience        NarrativeAudience
  periodStart     DateTime
  periodEnd       DateTime
  headline        String
  body            Json // { sections:[{ key, title, claims:[{ text, figures:[{value,unit,evidenceRef}] }] }] }
  evidenceRefs    Json // string[] — the de-duplicated audit trail of cited rows
  confidenceScore Float // 0–100 report-level confidence
  confidenceBasis Json // [{ key, weight, value }] — the score's own breakdown
  createdAt       DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("stakeholder_narratives")
}

// An approval gate on a plan/reallocation. Opt-in (Plan.requiresApproval): a
// strategist's plan can require a sign-off before a buyer executes it. Request
// + decision both write a CollaborationEvent — "all in the audit log."
model ApprovalRequest {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @db.Uuid
  planId        String?       @db.Uuid
  subjectType   String // e.g. "PLAN", "REALLOCATION"
  subjectId     String
  requestedById String        @db.Uuid
  state         ApprovalState @default(PENDING)
  decidedById   String?       @db.Uuid
  reason        String?
  createdAt     DateTime      @default(now())
  decidedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state])
  @@index([planId])
  @@map("approval_requests")
}

// The collaboration audit log — every approval, handoff, and narrative
// generation. Sibling to the execution-typed AuditLog (which is tied to
// ActionType/Meta); collaboration events don't fit that, so they live here.
model CollaborationEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  actorId     String?                @db.Uuid
  type        CollaborationEventType
  subjectType String
  subjectId   String
  fromRole    WorkspaceRole?
  toRole      WorkspaceRole?
  detail      Json?
  createdAt   DateTime               @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([subjectId])
  @@map("collaboration_events")
}

// ════════════════════════════════════════════════════════════
// PHASE 9 — AGENTIC OS (the nervous system: run the loop)
// ════════════════════════════════════════════════════════════

// One audit row per loop sweep — when Lumi ran the detect→propose pass, what
// it surfaced, and whether the loop is closed. The proposals themselves stay
// in their existing rows (Decision/TestExperiment/AllocationPlan); this is the
// thin audit, NOT a parallel proposal store. The monitoring fields (closed /
// loopHealth / staleStages) are lifted out of `stageStatus` JSON so queries
// like "show stalled loops" are an index scan, not a JSON dig.
model LoopRun {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  trigger     LoopTrigger
  startedAt   DateTime
  finishedAt  DateTime?

  proposalsByType Json // { VERDICT, REALLOCATION, TEST, PLAN_ADJUSTMENT, ... } counts
  stageStatus     Json // full per-stage detail [{ stage, state, lastAt, count }]
  summary         String
  aiInsight       String? // pre-generated portfolio briefing paragraph (1-2 sentences)

  // Queryable monitoring (lifted out of stageStatus JSON).
  closed      Boolean
  loopHealth  LoopHealth
  staleStages Json // the stale LOOP_STAGE keys, e.g. ["EXECUTE","LEARN"]

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, loopHealth])
  @@map("loop_runs")
}

// ════════════════════════════════════════════════════════════
// ADMIN AUDIT — who did what from the operator panel
// ════════════════════════════════════════════════════════════

// The admin-panel action types. A THIRD audit taxonomy alongside the
// execution-typed AuditLog (ActionType/Meta) and CollaborationEvent — admin
// actions are neither platform executions nor in-workspace collaboration, and
// overloading either enum would pollute the switches that read them.
enum AdminAuditType {
  CHANGE_ROLE
  CHANGE_PLAN
  SEED_DEMO
  DELETE_DEMO
  // Deletion of a REAL (non-demo) workspace. Deliberately distinct from
  // DELETE_DEMO: the log's whole purpose is to answer "was a customer account
  // ever destroyed, by whom", and one type for both could not.
  DELETE_WORKSPACE
}

// One row per admin-panel mutation.
//
// Deliberately UNLIKE its two sibling logs in three ways:
//   1. NO workspace relation. Both AuditLog and CollaborationEvent declare
//      `onDelete: Cascade`, which would delete the DELETE_DEMO row along with
//      the workspace it records — erasing the single most important event.
//      `workspaceId` is a plain nullable column here, and outlives its target.
//   2. The actor is a Firebase uid + email, not a User uuid. firebaseAuth puts
//      only `decodedToken.uid` on the request; resolving it to User.id would
//      cost a lookup per write, and the email is what an operator reads anyway.
//   3. No `workspaceId` scoping on reads. This log is cross-workspace by
//      definition, like the panel that writes it.
model AdminAuditLog {
  id          String         @id @default(uuid())
  actorUid    String // Firebase uid (req.userId)
  actorEmail  String // req.user.email — the human-readable actor
  type        AdminAuditType
  targetType  String // 'USER' | 'WORKSPACE'
  targetId    String
  workspaceId String? // plain column, NO @relation — survives a workspace delete
  before      Json? // state before the change (null for creations)
  after       Json? // state after the change (null for deletions)
  createdAt   DateTime       @default(now())

  @@index([actorUid])
  @@index([workspaceId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

// ── AI usage metering ────────────────────────────────────────
// One row per provider ATTEMPT-SEQUENCE through the AI gateway — not per
// capability call. A request that exhausts its retries on the primary and then
// succeeds on the cross-provider fallback writes TWO rows, because two
// providers were billed for one piece of work. `attempts` records how many
// times each sequence hit the API.
//
// Like AdminAuditLog and for the same reason, `workspaceId` carries NO
// @relation: spend is a fact about money, and deleting a workspace must not
// erase the record that it cost something. Nullable because attribution is
// genuinely best-effort — the gateway's `workspaceId` is optional, so NULL
// means "unattributed", never a placeholder.
//
// Every token column is nullable ON PURPOSE. NULL is "the provider did not
// report this"; 0 is "it reported zero". Collapsing the two would let a cost
// view render an unmeasured call as $0.00 — a fabricated measurement, and the
// exact failure this whole track exists to avoid.
//
// Cost is NOT stored. It is derived from tokens × a pricing table that changes
// under us (providerCosts.js is dated and versioned); persisting a dollar
// figure would freeze a stale rate into a row that looks authoritative forever.
model AiUsageLog {
  id           String  @id @default(uuid())
  workspaceId  String? // plain column, NO @relation — survives a workspace delete
  capability   String // CAPABILITY enum value, e.g. 'GENERATE_COPY'
  provider     String // 'CLAUDE' | 'OPENAI' | 'HIGGSFIELD'
  model        String? // what the API resolved on success; what was requested on failure
  inputTokens  Int? // null = unreported by the provider (NEVER 0-as-unknown)
  outputTokens Int? // null = unreported
  tokens       Int? // provider's own total (Claude: sum; OpenAI: total_tokens)
  latencyMs    Int?
  attempts     Int? // API calls in this sequence — a retry costs money too
  success      Boolean @default(true)
  // TRUE only for a cross-provider fallback (routingDecision.strategy ===
  // 'fallback'), never for a retry against the same provider. Conflating the
  // two would make "we paid two providers for one request" unreadable.
  isFallback   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([provider])
  @@map("ai_usage_logs")
}

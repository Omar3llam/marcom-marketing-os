// ============================================================
// MARCOM / Lumi — Prisma Schema (Phase 1: Temporal Brain)
// ============================================================
// Database: PostgreSQL
// Generator: prisma-client-js
//
// This schema introduces the persistent "temporal intelligence"
// layer for Lumi: Workspaces, Users, OAuth tokens, the Action
// engine with audit + idempotency, Campaign state tracking,
// Decision memory, and Webhook deduplication.
//
// IMPORTANT: This schema is additive. It does NOT yet replace
// the existing Airtable-backed `MARCOM_Sessions` table or the
// Postgres tables used by /api/history/* and /api/projects/*.
// Migration paths for those legacy stores are listed in the
// "Migration conflict notes" section accompanying this file.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Required for migrations on Neon pooler (falls back to DATABASE_URL if not set)
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  VIEWER
}

enum ActionStatus {
  PENDING
  QUEUED
  EXECUTED_SUCCESS
  FAILED
  ROLLED_BACK
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  PENDING
  PAUSED_FOR_APPROVAL
  RESUMING
  RESUMED
}

enum ActionType {
  PAUSE_CAMPAIGN
  RESUME_CAMPAIGN
  INCREASE_BUDGET
  DECREASE_BUDGET
  PAUSE_ADSET
  RESUME_ADSET
  SCALE_CAMPAIGN
  OPTIMIZE_CAMPAIGN
  // Phase 2 — first-class verdict execution paths
  REALLOCATE_BUDGET
  REFRESH_CREATIVE
}

enum CampaignStage {
  TESTING
  SCALING
  STABLE
  FATIGUED
  DYING
}

// ── Phase 1: Marketing OS substrate enums ────────────────────
// The platform an entity physically lives on.
enum Channel {
  META
  GOOGLE
  TIKTOK
  SNAP
  LINKEDIN
}

// Level of an entity in the normalized graph
// (Account → Campaign → AdSet → Ad → Creative).
enum EntityLevel {
  ACCOUNT
  CAMPAIGN
  ADSET
  AD
  CREATIVE
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// Origin of a metric. Intentionally distinct from `Channel`:
// a Meta entity can have conversion truth sourced from GA4 or
// Shopify. Keeping this separate from day one means the
// Conversion Truth join (Phase N) does NOT require a table rebuild.
enum DataSource {
  META
  GOOGLE
  TIKTOK
  SNAP
  LINKEDIN
  GA4
  SHOPIFY
  MANUAL
}

// Time grain of a MetricSnapshot row.
enum Granularity {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

// Marketing decision verdict (the Lumi call on an entity).
enum Verdict {
  KILL
  HOLD
  SCALE
  WATCH
  // Phase 2 — first-class verdicts with their own execution paths
  REALLOCATE
  REFRESH
}

// Comparator for guardrail rule conditions.
enum Comparator {
  GT
  GTE
  LT
  LTE
}

// Unit a guardrail threshold is expressed in.
enum ThresholdUnit {
  MINOR // integer minor units (money)
  RATIO // e.g. roas 2.4, frequency 3.5
  PCT // percentage points, e.g. "+50%" over target
}

// Phase 3 — capital allocation goal. Engine is goal-generic; only
// GROWTH_CEILING is implemented today (TARGET_CAC/TARGET_ROAS reserved).
enum GoalType {
  GROWTH_CEILING
}

// Lifecycle of a proposed allocation plan.
enum AllocationStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

// ── Phase 4: Testing OS ──────────────────────────────────────
// The four dimensions a performance buyer actually tests each week.
enum TestDimension {
  HOOK
  OFFER
  AUDIENCE
  CREATIVE_ANGLE
}

// Lifecycle of an experiment. A test is "finished" only at CONCLUDED —
// when its outcome is read and written to Decision Memory.
enum TestStatus {
  PROPOSED
  RUNNING
  CONCLUDED
  ABANDONED
}

// ── Phase 5: Memory Moat ─────────────────────────────────────
// The kinds of durable pattern mined from one workspace's own history.
enum PatternKind {
  FATIGUE_CEILING
  SCALING_WINDOW
  CREATIVE_ANGLE_LONGEVITY
  SEASONAL_EFFECT
}

// Pattern lifecycle. ESTABLISHED requires recency-weighted support AND
// accuracy; SUPERSEDED/CONFLICTED are conflict-resolution outcomes (a
// reconciled or contested pattern is never promoted to a rule).
enum PatternStatus {
  EMERGING
  ESTABLISHED
  SUPERSEDED
  CONFLICTED
}

// ── Phase 6: Planning OS ─────────────────────────────────────
// Lifecycle of a forward-looking plan (budget + mix + tests + goal).
enum PlanStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// North-star tracking status. AT_RISK can fire from the lagging trend OR
// a leading fatigue signal that breaches before period end.
enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  MISSED
}

// Is current CAC sustainable given LTV? HEALTHY ≥ target (3.0),
// THIN 1–3, UNDERWATER < 1.
enum SustainabilityBand {
  HEALTHY
  THIN
  UNDERWATER
}

// ── Phase 7: Measurement OS ──────────────────────────────────
// Attribution/incrementality is Agency/Enterprise depth, OFF by default.
enum MeasurementTier {
  NONE
  AGENCY
  ENTERPRISE
}

// Attribution models. NOTE the deliberate absence of a DATA_DRIVEN id:
// market "DDA" means Google's path-based Shapley/Markov over user journeys,
// which we cannot compute honestly (no path data). Our causal model is
// INCREMENTALITY_WEIGHTED (credit by MEASURED holdout lift) — naming it
// DATA_DRIVEN would itself be a quiet lie.
enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LINEAR
  POSITION_BASED
  INCREMENTALITY_WEIGHTED
}

// A holdout is "finished" only at CONCLUDED — when its lift is read out
// with a confidence interval and written to memory.
enum IncrementalityStatus {
  DESIGNED
  RUNNING
  CONCLUDED
  ABANDONED
}

// The confidence half of the honesty contract.
enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// ── Phase 8: Collaboration & Reporting OS ────────────────────
// Collaboration role — orthogonal to the system UserRole (ADMIN/VIEWER).
// A null collabRole falls back to STRATEGIST so seats predating Phase 8 are
// never locked out.
enum WorkspaceRole {
  STRATEGIST
  BUYER
  CLIENT
}

// Team & Roles — lifecycle of an emailed workspace invitation. The actual
// JOIN happens in firebaseAuth auto-provision: a first-time signup whose email
// has a PENDING, unexpired invite lands in the inviting workspace instead of a
// fresh one (single-use → marked ACCEPTED on join).
enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum NarrativePeriod {
  WEEKLY
  MONTHLY
}

enum NarrativeAudience {
  STRATEGIST
  BUYER
  LEADERSHIP
}

enum ApprovalState {
  PENDING
  APPROVED
  REJECTED
}

// The collaboration audit-log event types (CollaborationEvent). Distinct from
// the execution-typed AuditLog so we never overload ActionType.
enum CollaborationEventType {
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  HANDOFF
  NARRATIVE_GENERATED
}

// ── Phase 9: Agentic OS ──────────────────────────────────────
// What kicked off a loop sweep.
enum LoopTrigger {
  SCHEDULED // the cron heartbeat (proactive)
  MANUAL // a human pressed "Run sweep now"
  ON_READ // the home loaded and the last sweep was stale (no cron)
}

// Overall loop health — a queryable column so monitoring doesn't dig JSON.
enum LoopHealth {
  HEALTHY // closed loop, nothing stale
  DEGRADED // a non-blocking stage is ageing/stale
  STALLED // proposals piling up unexecuted, or the loop never closed
}

enum WebhookProvider {
  META
  GOOGLE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum TransitionActor {
  WORKER
  TIMEOUT_HANDLER
  USER
  API
  RECONCILIATION
  RETRY_POLICY
  SYSTEM
}

// ── Core Models ──────────────────────────────────────────────

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("USD") // ISO 4217 currency code (EGP, USD, SAR, AED, etc.)
  createdAt DateTime @default(now())

  // ── Onboarding preferences (promoted from User.context so workspace-scoped
  // services can read them — see routes/campaigns/context.js). All nullable /
  // empty-default: existing rows and skipped steps never break.
  spendTier  String?  // onboarding tier id: 't1'..'t4' (no billing meaning)
  objective  String?  // onboarding goal id: 'roas' | 'conversions' | 'ltv' | 'custom'
  adChannels String[] // normalized Channel values the account runs, e.g. ['META','GOOGLE']

  // ── Phase 5: network memory (opt-in, anonymized) ─────────────
  // Sharing this account's anonymized patterns into the cross-account
  // network is OFF by default — a governance decision, never a default.
  networkConsent Boolean   @default(false)
  cohortTag      String? // e.g. "EG-apparel" — the anonymization cohort
  consentedAt    DateTime?

  users                      User[]
  actions                    Action[]
  campaignStates             CampaignState[]
  decisionMemory             DecisionMemory[]
  auditLogs                  AuditLog[]
  artifacts                  Artifact[]
  artifactApprovals          ArtifactApproval[]
  approvalDecisions          ApprovalDecision[]
  publishedCreatives         PublishedCreative[]
  providerPerformanceMetrics ProviderPerformanceMetrics[]
  contentGenerations         ContentGeneration[]
  reinforcementSnapshots     ReinforcementSnapshot[]

  // ── Phase 1: Marketing OS substrate ──────────────────────────
  accounts              Account[]
  campaignEntities      Campaign[]
  adSets                AdSet[]
  ads                   Ad[]
  creatives             Creative[]
  metricSnapshots       MetricSnapshot[]
  decisions             Decision[]
  outcomeSnapshots      OutcomeSnapshot[]
  decisionMemoryEntries DecisionMemoryEntry[]
  fatiguePredictions    FatiguePrediction[]
  guardrailRules        GuardrailRule[]
  allocationPlans       AllocationPlan[]
  testExperiments       TestExperiment[]
  accountPatterns       AccountPattern[]
  patternObservations   PatternObservation[]

  // ── Phase 6: Planning OS ─────────────────────────────────────
  accountEconomics AccountEconomics?
  plans            Plan[]
  northStarGoals   NorthStarGoal[]

  // ── Phase 7: Measurement OS ──────────────────────────────────
  // Attribution/incrementality is gated; OFF by default (not core).
  measurementTier     MeasurementTier      @default(NONE)
  incrementalityTests IncrementalityTest[]
  pathTouches         PathTouch[]

  // ── Phase 8: Collaboration & Reporting OS ────────────────────
  stakeholderNarratives StakeholderNarrative[]
  approvalRequests      ApprovalRequest[]
  collaborationEvents   CollaborationEvent[]
  invitations           Invitation[]

  // ── Phase 9: Agentic OS ──────────────────────────────────────
  loopRuns           LoopRun[]
  campaignReasonings CampaignReasoning[]

  @@map("workspaces")
}

model User {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  email       String         @unique
  // ── Clerk → JWT cutover ────────────────────────────────────
  // Nullable string mapping the legacy Clerk subject (e.g.
  // "user_2abcXYZ...") to the new internal UUID. AuthMiddleware
  // resolves an inbound JWT `sub` claim to User.id via this column
  // until Clerk is fully retired in Phase 5+.
  clerkId     String?        @unique
  role        UserRole       @default(VIEWER)
  // ── Phase 8: collaboration role (orthogonal to system `role`) ──
  // STRATEGIST / BUYER / CLIENT. Null ⇒ treated as STRATEGIST by roleScope.
  collabRole  WorkspaceRole?
  // ── Onboarding context (B3 decision) ───────────────────────
  // Brand voice / business model / market / etc. captured by the
  // OnboardingPage wizard. JSON shape is defined by the client
  // (see client/src/pages/OnboardingPage.jsx). Null until the
  // user completes onboarding; blocks the /app route until set.
  context     Json?
  createdAt   DateTime       @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oauthTokens        OAuthToken[]
  contentGenerations ContentGeneration[]

  @@index([workspaceId])
  @@map("users")
}

// ── Content Lab: saved generations (history) ─────────────────
// One row per successful Content Lab generation. Persisted best-effort AFTER
// the AI call so a save failure never blocks the response. Workspace-scoped so
// the team shares a history; `createdById` is the internal User.id (resolved
// from the Firebase uid via clerkId — NEVER req.userId, which is the uid).
// `content` = the returned { copy, headlines, ctas, visual, video }; `context`
// = what it was generated for (campaign/tone/brand/audience/industry/objective/
// format/options). Both JSON — the shape is owned by the route, not the schema.
model ContentGeneration {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  createdById String   @db.Uuid
  content     Json
  context     Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("content_generations")
}

// ── Campaign verdict reasoning: pre-generated "Lumi's Read" ──────
// One row per campaign (upsert). Written best-effort during the agentic sweep
// (top-N by impact score) so the campaign drill-down shows an INSTANT, plain-
// language read of the verdict instead of an on-demand LLM round-trip.
// `reasoning` is prose from the AI gateway; `verdict`/`impactScore` are the
// signals AT generation time (lets the UI show "stale" when they drift or the
// row ages out). `sweepId` = the LoopRun that produced it. Non-authoritative —
// safe to wipe and regenerate on any sweep. Workspace-scoped so the team shares.
model CampaignReasoning {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  entityId    String   // connector campaign entityId (deterministic; not a DB uuid)
  reasoning   String
  verdict     String
  impactScore Int?
  sweepId     String?  // LoopRun.id that generated this (null when ad-hoc)
  generatedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityId])
  @@index([workspaceId, generatedAt(sort: Desc)])
  @@map("campaign_reasonings")
}

// ── Team & Roles: workspace invitation ───────────────────────
// One PENDING invite per (workspace, email). The token backs the email accept
// link; the join itself is email-matched in the firebaseAuth seam, so the token
// is opaque/single-use (status flips to ACCEPTED on first join). Cascade-deletes
// with its workspace, so a deleted workspace never strands a live invite.
model Invitation {
  id          String           @id @default(cuid())
  workspaceId String           @db.Uuid
  email       String
  collabRole  WorkspaceRole    @default(BUYER)
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@index([workspaceId])
  @@map("invitations")
}

model OAuthToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  provider          String
  accessToken       String
  refreshToken      String?
  encryptionVersion String
  expiresAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@map("oauth_tokens")
}

// NOTE: The Integration model (table "integrations") was removed 2026-06-15.
// It was write-dead — nothing populated it — and every Meta/Google credential
// read now goes through credentialStore (marcom_credentials), the
// OAuth-authoritative store. Dropped in migration 20260615000000_drop_integration_model.

// ── Action Engine ────────────────────────────────────────────

model Action {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  campaignId     String
  idempotencyKey String       @unique
  status         ActionStatus @default(PENDING)
  payload        Json
  createdAt      DateTime     @default(now())
  executedAt     DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([workspaceId, status])
  @@index([campaignId])
  @@map("actions")
}

model AuditLog {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  userId       String          @db.Uuid
  actionId     String?         @db.Uuid
  actionType   ActionType
  targetId     String // Campaign ID, AdSet ID, etc.
  platform     String // e.g., "META", "GOOGLE"
  status       ExecutionStatus @default(PENDING)
  payload      Json? // Original request payload
  response     Json? // Platform response
  errorMessage String? // If status = FAILED
  performedAt  DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action    Action?   @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, performedAt(sort: Desc)])
  @@index([targetId])
  @@index([actionType])
  @@index([status])
  @@map("audit_logs")
}

// ── Idempotency Protection ──────────────────────────────────
// Prevents duplicate Meta executions from double-clicks, retries,
// and flaky networks. Each execution request generates a unique
// idempotencyKey. If the same key arrives again, we replay the
// stored response instead of re-executing on Meta.

model ExecutionRequest {
  id             String   @id @default(cuid())
  workspaceId    String   @db.Uuid
  idempotencyKey String   @unique
  actionType     String
  targetId       String
  status         String // PENDING, QUEUED, EXECUTING, EXECUTED_SUCCESS, EXECUTED_FAILED, TIMED_OUT, CANCELLED
  payload        Json? // Original request payload
  response       Json? // Meta API response (success or error)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Phase 11B: Lifecycle Governance ───────────────────────
  version       Int     @default(0) // Optimistic concurrency control (OCC)
  correlationId String? // Correlation lineage for distributed tracing
  activeStep    String? // Current orchestration step
  retryMetadata Json? // { attempt, maxAttempts, nextRetryAt }

  transitions       ExecutionTransition[]
  metrics           ExecutionMetric[]
  decisionMemory    DecisionMemory[]
  artifacts         Artifact[]
  checkpoints       ExecutionCheckpoint[]
  approvalDecisions ApprovalDecision[]

  @@index([workspaceId])
  @@index([createdAt])
  @@index([status])
  @@index([correlationId])
  @@map("execution_requests")
}

// ── Phase 11B Task 7: ExecutionTransition Audit Log ──────────
// Immutable append-only log of every state transition.
// Enables forensic debugging, replay, timeline UI, and incident analysis.
//
// Architectural Law:
// Every state mutation must emit a durable transition record.
//
// Query patterns:
// - Execution timeline: WHERE executionId = ? ORDER BY createdAt
// - Actor audit: WHERE actor = 'worker' AND workspaceId = ?
// - Version conflicts: WHERE executionId = ? AND previousVersion != newVersion - 1
// - Correlation lineage: WHERE correlationId = ? ORDER BY createdAt

model ExecutionTransition {
  id          String @id @default(cuid())
  executionId String
  workspaceId String @db.Uuid

  fromStatus String
  toStatus   String

  actor TransitionActor

  correlationId String?
  reason        String? // e.g., "sse_disconnect", "timeout_exceeded", "user_cancel"

  previousVersion Int
  newVersion      Int

  metadata Json? // Optional metadata (e.g., retry attempt, error context)

  createdAt DateTime @default(now())

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actor])
  @@index([correlationId])
  @@map("execution_transitions")
}

// ── PR #14: Execution Metrics ────────────────────────────────
// Append-only record written after every terminal transition.
// Used by GET /api/execute/metrics/summary.
// READ-ONLY from the observability layer — never mutates execution state.

model ExecutionMetric {
  id          String @id @default(cuid())
  executionId String
  workspaceId String @db.Uuid

  // Timing (derived from ExecutionTransition audit log)
  queueWaitMs Int? // PENDING → EXECUTING elapsed ms
  executionMs Int? // EXECUTING → terminal elapsed ms

  // Outcome counters
  retryCount      Int     @default(0)
  timeoutOccurred Boolean @default(false)

  // Agent attribution (from execution response payload)
  agentUsed     String? // "claude" | "openai" | "hybrid"
  tokenEstimate Int?

  finalStatus String // EXECUTED_SUCCESS | EXECUTED_FAILED | TIMED_OUT
  recordedAt  DateTime @default(now())

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordedAt(sort: Desc)])
  @@index([executionId])
  @@map("execution_metrics")
}

// ── PR #29: Execution Checkpoints ────────────────────────────
// Persistent state snapshots for resumable execution.
// Enables pause/resume capability for human-in-the-loop approval workflows.
//
// Architectural Law:
// Every execution pause must create a durable checkpoint.
//
// Query patterns:
// - Latest checkpoint: WHERE executionId = ? ORDER BY createdAt DESC LIMIT 1
// - Resume candidates: WHERE status = 'PAUSED' AND resumedAt IS NULL
// - Checkpoint timeline: WHERE executionId = ? ORDER BY createdAt

model ExecutionCheckpoint {
  id              String    @id @default(cuid())
  executionId     String
  workspaceId     String    @db.Uuid
  nodeId          String // Current node position in execution graph
  status          String // PAUSED_FOR_APPROVAL, RESUMING, RESUMED
  serializedState Json // Full execution graph state for deterministic resume
  pausedReason    String? // e.g., "awaiting_artifact_approval", "manual_pause"
  createdAt       DateTime  @default(now())
  resumedAt       DateTime?

  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([status])
  @@map("execution_checkpoints")
}

// ── Temporal Intelligence ────────────────────────────────────

model CampaignState {
  id           String        @id @default(uuid()) @db.Uuid
  campaignId   String
  campaignName String        @default("")
  workspaceId  String        @db.Uuid
  stage        CampaignStage
  healthScore  Float
  lastAnalysis DateTime
  updatedAt    DateTime      @updatedAt
  currency     String        @default("USD") // ISO 4217 currency code (EGP, USD, SAR, AED, EUR, GBP)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, workspaceId])
  @@index([workspaceId])
  @@map("campaign_states")
}

model DecisionMemory {
  id            String   @id @default(cuid())
  workspaceId   String   @db.Uuid
  executionId   String
  correlationId String?
  decisionType  String
  signalType    String
  diagnosis     String
  actionTaken   String
  outcome       String
  confidence    Float
  createdAt     DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([executionId])
  @@index([correlationId])
  @@map("decision_memory")
}

// ── Webhook Deduplication ────────────────────────────────────

model WebhookEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        WebhookProvider
  externalEventId String          @unique
  payload         Json
  processedAt     DateTime        @default(now())
  status          WebhookStatus   @default(RECEIVED)

  @@index([provider, status])
  @@map("webhook_events")
}

// ── PR #27: Artifact Storage ─────────────────────────────────
// Persistent storage for AI-generated artifacts (hooks, captions,
// visual briefs, etc.). Supports versioning, retrieval, and
// metadata tracking. Actual artifact content stored via adapter
// (local filesystem or S3), this table tracks metadata + location.

model Artifact {
  id          String   @id @default(cuid())
  workspaceId String   @db.Uuid
  executionId String
  nodeId      String
  nodeType    String
  type        String // 'hook', 'caption', 'visual_brief', 'audience_hypothesis', 'angle', etc.
  storageKey  String // Adapter-specific storage location (local path or S3 key)
  capability  String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.
  provider    String // CLAUDE, OPENAI
  version     Int      @default(1)
  size        Int? // Artifact size in bytes
  contentHash String? // SHA256 hash for deduplication
  content     String? // Optional: store small artifacts inline (< 1KB)
  metadata    Json? // Provider metadata (tokens, latency, requestId, model, etc.)
  createdAt   DateTime @default(now())

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution          ExecutionRequest    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approval           ArtifactApproval?
  decisions          ApprovalDecision[]
  publishedCreatives PublishedCreative[]

  @@index([workspaceId, type])
  @@index([executionId])
  @@index([nodeId])
  @@index([createdAt(sort: Desc)])
  @@index([contentHash])
  @@map("artifacts")
}

// ── PR #28: Artifact Approval Workflow ───────────────────────────
// Human-in-the-loop approval system for AI-generated artifacts.
// Enables review/approve/reject flow before publishing.
// Phase 1: Approval tracking (no runtime pause/resume yet).
//
// ── PR #30: Approval Decision Engine ─────────────────────────────
// Rich decision semantics beyond boolean approve/reject.
// Enables selective re-execution, escalation, and revision requests.
//
// Decision taxonomy:
// - APPROVED: Artifact ready for publishing
// - REJECTED: Artifact discarded, execution continues
// - REQUEST_REVISION: Request changes with specific instructions
// - REGENERATE: Re-run generation node with same inputs
// - ESCALATE: Route to human reviewer/manager for decision
//
// Architectural Law:
// rejection ≠ regeneration — different failure modes need different responses.

model ArtifactApproval {
  id          String @id @default(cuid())
  artifactId  String @unique
  workspaceId String @db.Uuid

  status     String // PENDING, COMPLETED (workflow state)
  decision   String? // APPROVED, REJECTED, REQUEST_REVISION, REGENERATE, ESCALATE (decision outcome)
  reviewerId String? @db.Uuid // User who made the decision
  feedback   String? // Decision reason/notes

  // PR #30: Rich decision metadata
  decisionMetadata Json? // { revisionInstructions, targetNodes, escalationReason, regenerationHint }
  escalatedTo      String?   @db.Uuid // User/role ID for escalation target
  escalatedAt      DateTime?

  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  artifact         Artifact          @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvalDecision ApprovalDecision?

  @@index([workspaceId, status])
  @@index([artifactId])
  @@index([status])
  @@index([decision])
  @@index([escalatedTo])
  @@index([createdAt(sort: Desc)])
  @@map("artifact_approvals")
}

// ── PR #37: Approval Decision Analytics ──────────────────────────
// Captures approval decisions for intelligence feedback loops.
// Enables provider performance tracking, feedback pattern detection,
// and artifact risk scoring.
//
// Architectural Law:
// Every approval decision must be recorded for learning.
//
// Query patterns:
// - Provider performance: WHERE provider = ? AND decision = ? GROUP BY decision
// - Feedback patterns: GROUP BY feedbackType ORDER BY count DESC
// - Artifact risk: WHERE capability = ? AND decision IN ('REGENERATE', 'REJECTED')
// - Reviewer behavior: WHERE reviewerId = ? AND reviewedAt > ?
// - Severity distribution: GROUP BY severity, decision

model ApprovalDecision {
  id          String @id @default(cuid())
  approvalId  String @unique
  artifactId  String
  executionId String
  workspaceId String @db.Uuid

  // Decision data (from frontend ApprovalForm)
  decision        String // APPROVED | REJECTED | REGENERATE | REQUEST_REVISION | ESCALATE
  feedback        String? // Free-form feedback text
  feedbackType    String? // hook_angle, tone, cta, clarity, length, brand_voice, etc.
  severity        String? // LOW | MEDIUM | HIGH
  preserveAspects String[] // brand_voice, tone, cta, color_palette, etc.

  // Attribution (from Artifact record for provider performance tracking)
  provider   String? // claude, openai, higgsfield
  capability String? // GENERATE_HOOKS, GENERATE_CAPTIONS, GENERATE_VISUAL_BRIEF, etc.
  model      String? // claude-opus-4, gpt-4, claude-sonnet-3-5, etc.
  // NOTE: executionCost NOT included - cost tracking to be added in future PR

  // Reviewer tracking
  reviewerId String   @db.Uuid
  reviewedAt DateTime @default(now())

  // Relations
  approval  ArtifactApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  artifact  Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  execution ExecutionRequest @relation(fields: [executionId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Analytics indexes
  @@index([workspaceId, reviewedAt(sort: Desc)])
  @@index([provider, decision])
  @@index([capability, decision])
  @@index([feedbackType])
  @@index([severity])
  @@index([executionId])
  @@index([reviewerId])
  @@map("approval_decisions")
}

// ── PR #41: Outcome Attribution Engine ───────────────────────────
// Links artifacts to Meta ads and tracks real business performance.
// Enables provider routing based on actual CTR/CPC/ROAS, not just approval rates.
//
// Flow: Artifact → Approval (APPROVED) → PublishedCreative (Meta ad) → ProviderPerformanceMetrics (CTR/CPC/ROAS)
//
// Query patterns:
// - Published artifacts: WHERE artifactId = ?
// - Ad performance: WHERE metaAdId = ?
// - Provider attribution: JOIN artifacts → publishedCreatives → performanceMetrics WHERE provider = ?
// - Campaign performance: WHERE metaCampaignId = ?

model PublishedCreative {
  id          String @id @default(cuid())
  artifactId  String
  workspaceId String @db.Uuid

  // Meta attribution
  metaAdId       String // Meta ad ID
  metaCampaignId String // Meta campaign ID
  metaAdsetId    String? // Meta adset ID (optional)

  // Publishing metadata
  publishedBy String   @db.Uuid // User who published
  publishedAt DateTime @default(now())

  // Creative metadata
  adName   String? // Meta ad name
  adStatus String? // ACTIVE, PAUSED, ARCHIVED

  // Relations
  artifact           Artifact                     @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  performanceMetrics ProviderPerformanceMetrics[]

  @@index([workspaceId, publishedAt(sort: Desc)])
  @@index([artifactId])
  @@index([metaAdId])
  @@index([metaCampaignId])
  @@map("published_creatives")
}

model ProviderPerformanceMetrics {
  id                  String @id @default(cuid())
  publishedCreativeId String
  workspaceId         String @db.Uuid

  // Attribution (denormalized for fast queries)
  provider   String // claude, openai, higgsfield
  capability String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.
  model      String? // claude-opus-4, gpt-4, etc.

  // Meta performance metrics
  impressions Int    @default(0)
  clicks      Int    @default(0)
  ctr         Float? // Click-through rate (clicks / impressions)
  cpc         Float? // Cost per click
  spend       Float  @default(0)
  conversions Int    @default(0)
  revenue     Float  @default(0)
  roas        Float? // Return on ad spend (revenue / spend)

  // Performance period
  startDate DateTime
  endDate   DateTime

  // Data freshness
  fetchedAt DateTime @default(now())

  // Relations
  publishedCreative PublishedCreative @relation(fields: [publishedCreativeId], references: [id], onDelete: Cascade)
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([publishedCreativeId, startDate, endDate])
  @@index([workspaceId, fetchedAt(sort: Desc)])
  @@index([publishedCreativeId])
  @@index([provider, capability])
  @@index([startDate, endDate])
  @@map("provider_performance_metrics")
}

model ReinforcementSnapshot {
  id          String  @id @default(cuid())
  workspaceId String? @db.Uuid

  // Provider + Capability (learning is scoped to this pair)
  provider   String // claude, openai, higgsfield
  capability String // GENERATE_HOOKS, GENERATE_CAPTIONS, etc.

  // Adaptive scores
  score      Float // Composite score (approval rate, CTR, ROAS, cost efficiency)
  confidence Float // Confidence level (0.0 - 1.0) based on sample size
  sampleSize Int // Number of data points in this snapshot

  // Performance window
  windowStart DateTime
  windowEnd   DateTime

  // Append-only audit trail
  createdAt DateTime @default(now())

  // Relations
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([provider, capability, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([windowStart, windowEnd])
  @@map("reinforcement_snapshots")
}

// ════════════════════════════════════════════════════════════
// PHASE 1 — MARKETING OS DATA SUBSTRATE
// ════════════════════════════════════════════════════════════
// Two interlocking graphs:
//   1. Entity graph:   Account → Campaign → AdSet → Ad → Creative
//   2. Decision graph: Entity → Decision → Outcome → Memory
// Plus a NUMERIC time-series (MetricSnapshot). No metric is ever
// stored as a pre-formatted string — money lives as integer minor
// units + an ISO 4217 currency code, formatted only at the
// presentation layer. See src/lib/money.js.
//
// The new `Campaign` model is the entity-graph node and is distinct
// from the legacy `CampaignState` (health snapshot) above. The new
// `Decision`/`OutcomeSnapshot`/`DecisionMemoryEntry` models are the
// marketing decision graph and are distinct from the legacy,
// execution-engine-scoped `DecisionMemory` model above.
// ════════════════════════════════════════════════════════════

// ── Entity graph ─────────────────────────────────────────────

model Account {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String? // platform-native id (e.g. act_98441)
  createdAt   DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([workspaceId])
  @@map("accounts")
}

model Campaign {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  accountId   String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  // Platform campaign objective (Meta OUTCOME_LEADS / OUTCOME_SALES /
  // OUTCOME_AWARENESS / …). Lets the verdict engine distinguish a true awareness
  // campaign from a conversion campaign with no measured revenue. Nullable:
  // pre-fix rows + non-Meta channels have none.
  objective   String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adSets    AdSet[]

  @@index([workspaceId])
  @@index([accountId])
  @@map("campaign_entities")
}

model AdSet {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  campaignId  String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads       Ad[]

  @@index([workspaceId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  adSetId     String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  createdAt   DateTime     @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adSet     AdSet      @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creatives Creative[]

  @@index([workspaceId])
  @@index([adSetId])
  @@map("ads")
}

model Creative {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  adId        String       @db.Uuid // parentId
  channel     Channel
  status      EntityStatus @default(ACTIVE)
  name        String
  externalId  String?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([adId])
  @@map("creatives")
}

// ── Numeric time-series ──────────────────────────────────────
// Polymorphic: a snapshot attaches to any entity level via
// (entityId, entityLevel) rather than a hard FK. Money fields are
// integer minor units; ratios are floats. `source` is the metric
// origin (may differ from the entity's channel); `granularity` is
// the time grain.

model MetricSnapshot {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  entityId    String      @db.Uuid
  entityLevel EntityLevel
  date        DateTime
  source      DataSource
  granularity Granularity @default(DAILY)

  // Money — integer minor units (e.g. piastres, halalas, fils, cents).
  spendMinor   Int  @default(0)
  revenueMinor Int  @default(0)
  cpaMinor     Int?

  // Counters
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  // Ratios (not money) — plain floats
  ctr       Float?
  roas      Float?
  frequency Float?

  currency String // ISO 4217 (EGP, SAR, AED, KWD, USD, …)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityId, entityLevel, date, granularity, source])
  @@index([workspaceId, entityId, entityLevel, date])
  @@index([entityId, date])
  @@map("metric_snapshots")
}

// ── Decision graph: Entity → Decision → Outcome → Memory ─────
// This is what makes Lumi an operating system rather than a
// dashboard. Phase 1 scaffolds the schema + contracts; feature
// logic lands in later phases.

model Decision {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  entityId    String      @db.Uuid
  entityLevel EntityLevel
  verdict     Verdict
  confidence  Float // 0.0 – 1.0
  diagnosis   String
  rootCause   String?
  status      String      @default("PROPOSED") // PROPOSED | EXECUTED | DISMISSED
  createdAt   DateTime    @default(now())

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outcomes  OutcomeSnapshot[]
  memories  DecisionMemoryEntry[]
  tests     TestExperiment[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityId, entityLevel])
  @@map("decisions")
}

model OutcomeSnapshot {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  decisionId  String      @db.Uuid
  entityId    String      @db.Uuid
  entityLevel EntityLevel

  // Realized result of acting on the decision (minor units).
  spendDeltaMinor   Int?
  revenueDeltaMinor Int?
  roasDelta         Float?

  windowStart DateTime?
  windowEnd   DateTime?
  sustained   Boolean? // did the lift hold?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([decisionId])
  @@map("outcome_snapshots")
}

model DecisionMemoryEntry {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  decisionId        String?  @db.Uuid
  entityId          String?  @db.Uuid
  actionType        String?
  rationale         String
  isSustainable     Boolean?
  impactDurationHrs Int?
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([decisionId])
  @@map("decision_memory_entries")
}

// ════════════════════════════════════════════════════════════
// PHASE 2 — PREDICTIVE + GUARDRAILS
// ════════════════════════════════════════════════════════════

// Forward-looking creative-fatigue forecast for an entity. Written
// each sweep; on resolution (actual breach or REFRESH executed) a
// DecisionMemoryEntry is written capturing predicted-vs-actual.
model FatiguePrediction {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @db.Uuid
  entityId            String      @db.Uuid
  entityLevel         EntityLevel
  metric              String      @default("frequency") // signal that will breach
  ceiling             Float // breach threshold (e.g. 3.5)
  projectedBreachDate DateTime
  confidence          Float // 0.0 – 1.0
  basis               String? // short human-readable basis of the projection
  createdAt           DateTime    @default(now())

  // Resolution (set when the forecast is confirmed or invalidated)
  resolvedAt       DateTime?
  actualBreachDate DateTime?
  accuracy         Float? // |projected - actual| scored 0..1 at resolution

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityId, entityLevel])
  @@index([resolvedAt])
  @@map("fatigue_predictions")
}

// User-defined recurring rule Lumi enforces each sweep. Hits produce
// radar verdicts (Decisions, status PROPOSED) — never auto-execution.
model GuardrailRule {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @db.Uuid
  name          String
  enabled       Boolean       @default(true)
  scopeLevel    EntityLevel   @default(ADSET)
  audienceTag   String? // optional filter, e.g. "cold"
  metric        String // e.g. "cpaOverTargetPct", "frequency", "roas"
  comparator    Comparator
  threshold     Float // interpreted per `unit`
  unit          ThresholdUnit @default(RATIO)
  sustainedDays Int           @default(1)
  emitVerdict   Verdict       @default(WATCH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled])
  @@map("guardrail_rules")
}

// ════════════════════════════════════════════════════════════
// PHASE 3 — CAPITAL ALLOCATION
// ════════════════════════════════════════════════════════════

// A proposed cross-channel budget distribution toward a goal, built on
// BLENDED truth (not platform claims). The container persists the goal,
// budget, projected blended impact, and the reasoning trail; each
// individual move is a PROPOSED REALLOCATE Decision linked back via
// `Decision.rootCause = "allocation:<planId>"`, so reallocations flow
// through the existing confirm→execute governance + audit. Never
// auto-executes.
model AllocationPlan {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  goalType         GoalType
  goalValue        Float? // interpretation depends on goalType (null for GROWTH_CEILING)
  totalBudgetMinor Int // the spend ceiling, integer minor units
  currency         String   @default("USD")

  // Projected blended impact (minor units / ratios).
  projectedRoas     Float?
  projectedCpaMinor Int?
  merBefore         Float? // blended MER before the reallocation
  merAfter          Float? // blended MER after the reallocation

  reasoning String // newline-joined reasoning trail
  status    AllocationStatus @default(PROPOSED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("allocation_plans")
}

// ════════════════════════════════════════════════════════════
// PHASE 4 — TESTING OS (closed-loop weekly experiments)
// ════════════════════════════════════════════════════════════

// A single weekly experiment across one of the four testing dimensions.
// Proposed by the generator, run by the buyer, and CONCLUDED by the
// readout — which writes the outcome to Decision Memory and (when the
// winner is confident + governance-valid) links a REFRESH/SCALE Decision.
model TestExperiment {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  entityId    String?      @db.Uuid // the campaign/adset the test runs on
  entityLevel EntityLevel?

  dimension      TestDimension
  hypothesis     String
  metric         String // the watched signal: CTR | CVR | ROAS | CPA
  expectedSignal String
  priority       Float         @default(0)
  status         TestStatus    @default(PROPOSED)
  currency       String        @default("USD")

  startedAt   DateTime?
  concludedAt DateTime?

  // Readout (set at conclusion).
  winnerLabel     String?
  lift            Float? // % improvement of winner vs control
  confidence      Float?
  confidenceLabel String? // HIGH | MODERATE | LOW | INCONCLUSIVE
  sampleNote      String?

  // The verdict Decision this test produced (null until/unless a
  // confident, governance-valid winner emerges).
  decisionId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision  Decision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  variants  TestVariant[]

  // Holdouts promoted from this concluded test (the Phase-7C bridge).
  incrementalityTests IncrementalityTest[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([status])
  @@index([entityId, entityLevel])
  @@map("test_experiments")
}

// One arm of a test (control or challenger). Carries the raw counts the
// readout engine reads — refreshed live from Meta Insights on conclude,
// or recorded manually for the demo/CI path.
model TestVariant {
  id          String  @id @default(uuid()) @db.Uuid
  testId      String  @db.Uuid
  label       String // "A", "B", "Hook A", …
  description String  @default("")
  isControl   Boolean @default(false)

  // Maps the arm to its Meta entity so insights can be pulled live.
  metaEntityId String?
  metaLevel    String? // AD | ADSET

  // Performance counts (money in integer minor units).
  impressions  Int     @default(0)
  clicks       Int     @default(0)
  conversions  Int     @default(0)
  spendMinor   Int     @default(0)
  revenueMinor Int     @default(0)
  isWinner     Boolean @default(false)

  createdAt DateTime @default(now())

  test TestExperiment @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("test_variants")
}

// ════════════════════════════════════════════════════════════
// PHASE 5 — MEMORY MOAT (per-account learning → playbooks)
// ════════════════════════════════════════════════════════════

// A durable pattern Lumi has learned about ONE account, mined from its own
// Decisions/Outcomes/Tests/MetricSnapshots. Confidence is truth-weighted
// (recency-weighted accuracy × support), not a raw count. A promotable
// pattern carries an executable guardrail spec; a SUPERSEDED/CONFLICTED
// pattern (conflict resolution) is never promoted.
model AccountPattern {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  patternKey  String // deterministic engine key — stable across re-extractions
  kind        PatternKind
  statement   String
  basis       String?

  // Truth, not just volume.
  support          Int           @default(1) // raw occurrence count
  effectiveSupport Float         @default(0) // recency-weighted support
  accuracy         Float? // recency-weighted "was Lumi right?" (null until known outcomes)
  confidence       Float
  status           PatternStatus

  // Promotable guardrail spec (null for informational kinds).
  metric        String?
  scopeLevel    EntityLevel?
  audienceTag   String?
  comparator    Comparator?
  threshold     Float?
  unit          ThresholdUnit?
  emitVerdict   Verdict?
  sustainedDays Int?

  // Conflict resolution + promotion provenance.
  supersededById String? @db.Uuid
  promotedRuleId String? @db.Uuid

  firstObservedAt DateTime
  lastObservedAt  DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  observations PatternObservation[]
  supersededBy AccountPattern?      @relation("PatternSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   AccountPattern[]     @relation("PatternSupersede")

  @@unique([workspaceId, patternKey])
  @@index([workspaceId, status])
  @@map("account_patterns")
}

// The accuracy audit trail — one row per pattern occurrence, recording
// what Lumi predicted vs what actually happened. This is what lets the
// memory answer "was Lumi right?" and decay stale evidence by date.
model PatternObservation {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  patternId     String   @db.Uuid
  decisionId    String?  @db.Uuid
  entityId      String?  @db.Uuid
  occurrenceKey String // stable dedup key so re-extraction never double-counts
  predicted     String
  actual        String?
  correct       Boolean?
  observedAt    DateTime
  createdAt     DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pattern   AccountPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([patternId, occurrenceKey])
  @@index([workspaceId, observedAt])
  @@map("pattern_observations")
}

// ════════════════════════════════════════════════════════════
// Phase 6 — Planning OS
// ════════════════════════════════════════════════════════════

// Per-workspace unit economics the strategist sets once and edits. Feeds
// the unit-economics engine (LTV / payback / contribution margin) AND the
// scenario engine's revenue/gross-profit outputs. AOV is seeded from
// blended truth when unset. Money in integer minor units.
model AccountEconomics {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @unique @db.Uuid
  currency             String   @default("USD")
  aovMinor             Int // average order value, minor units
  grossMarginPct       Float // gross margin as a ratio [0,1]
  repeatRate           Float    @default(0) // informational; folds into avgOrders
  avgOrdersPerCustomer Float    @default(1) // lifetime orders per customer
  targetLtvToCac       Float    @default(3) // sustainability target
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("account_economics")
}

// A quarterly north-star: e.g. "blended CAC ≤ X at Y spend". The
// goal-tracker engine projects a trend-based landing ESTIMATE (a range)
// and folds in leading fatigue signals. Optionally linked to the Plan it
// belongs to.
model NorthStarGoal {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  name              String
  metric            String // e.g. "blendedCac", "blendedRoas", "mer"
  comparator        Comparator // GTE for ROAS, LTE for CAC, …
  targetValue       Float
  spendCeilingMinor Int? // the "at Y spend" half of the target
  currency          String     @default("USD")
  periodStart       DateTime
  periodEnd         DateTime
  status            GoalStatus @default(ON_TRACK)
  planId            String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@map("north_star_goals")
}

// A forward-looking plan: assembled budget + channel mix + testing agenda
// + projections, all snapshotted as JSON. `memoryBasis` records WHICH
// Phase-5 patterns the plan leaned on (traceability — "why did Lumi
// suggest this?"). The mix promotes to PROPOSED REALLOCATE Decisions via
// the existing Phase-3 governance (allocationPlanId set on promote) — no
// new execution code.
model Plan {
  id               String         @id @default(uuid()) @db.Uuid
  workspaceId      String         @db.Uuid
  name             String
  periodStart      DateTime
  periodEnd        DateTime
  totalBudgetMinor Int
  currency         String         @default("USD")
  status           PlanStatus     @default(DRAFT)
  channelMix       Json // snapshot of the allocation preview
  testingAgenda    Json // snapshot of the Phase-4 weekly agenda
  projections      Json // scenario + econ + landing ranges, with assumptions
  memoryBasis      Json // [{ patternId, kind, statement, accuracy }] — "Powered by Memory"
  allocationPlanId String?        @db.Uuid // set when the mix is promoted (Phase-3 loop)
  // ── Phase 8: approval gate (opt-in per plan) ──────────────────
  // When requiresApproval, a buyer cannot promote/execute the plan until a
  // strategist signs off; approvalState tracks that PENDING→APPROVED gate.
  requiresApproval Boolean        @default(false)
  approvalState    ApprovalState?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goals     NorthStarGoal[]
  approvals ApprovalRequest[]

  @@index([workspaceId, status])
  @@map("plans")
}

// ════════════════════════════════════════════════════════════
// PHASE 7 — MEASUREMENT OS (attribution · incrementality)
// ════════════════════════════════════════════════════════════

// A holdout/incrementality experiment — the only CAUSAL measurement we
// run. Designed via a power calc, read out as a lift with a CONFIDENCE
// INTERVAL (never a point), and written to Decision Memory on conclude
// (mirrors the Phase-4 test loop). Money in integer minor units.
model IncrementalityTest {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String
  channel     String // e.g. "META" — the channel being held out
  entityId    String?      @db.Uuid
  entityLevel EntityLevel?

  // Provenance: the concluded A/B test this holdout was promoted from (the
  // Phase-7C bridge). Null for holdouts designed directly. SetNull on delete —
  // losing the source test never invalidates a running causal experiment.
  sourceTestId String?         @db.Uuid
  sourceTest   TestExperiment? @relation(fields: [sourceTestId], references: [id], onDelete: SetNull)

  // Design (from the power calc).
  holdoutPct       Float
  mde              Float // minimum detectable (relative) lift
  sampleSizePerArm Int
  durationDays     Int
  guardrails       Json

  status IncrementalityStatus @default(DESIGNED)

  // Observed counters (filled as the holdout runs).
  exposedUsers       Int @default(0)
  exposedConversions Int @default(0)
  holdoutUsers       Int @default(0)
  holdoutConversions Int @default(0)

  // Readout (causal lift + CI). Null until CONCLUDED.
  liftPct                 Float?
  ciLow                   Float?
  ciHigh                  Float?
  confidenceLabel         ConfidenceLevel?
  incrementalRevenueMinor Int?
  decisionId              String?          @db.Uuid // optional PROPOSED Decision on a confident result

  startedAt   DateTime?
  concludedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("incrementality_tests")
}

// The ingestion table that makes multi-touch attribution honest WHEN it is
// populated. Empty until a path/journey source (GA4 path export, etc.) is
// connected — until then the path-based attribution models honestly return
// INSUFFICIENT_DATA rather than invent journey credit.
model PathTouch {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  conversionId      String // groups touches into one conversion journey
  channel           String
  entityId          String?  @db.Uuid
  touchPosition     Int // 0-based order within the journey
  occurredAt        DateTime
  isConversionTouch Boolean  @default(false)
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, conversionId, touchPosition])
  @@map("path_touches")
}

// ════════════════════════════════════════════════════════════
// PHASE 8 — COLLABORATION & REPORTING OS
// ════════════════════════════════════════════════════════════

// A persisted, auto-generated stakeholder narrative — reasoned prose, NOT a
// dashboard. `body` holds the sections+claims+figures; EVERY figure carries an
// evidenceRef (a real row id) so nothing is hallucinated. `confidenceScore` +
// `confidenceBasis` keep the report-confidence itself auditable at rest (never
// a bare %). Leadership needs the durable weekly/monthly record, so these are
// persisted (alerts, by contrast, are routed live — no table).
model StakeholderNarrative {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  period          NarrativePeriod
  audience        NarrativeAudience
  periodStart     DateTime
  periodEnd       DateTime
  headline        String
  body            Json // { sections:[{ key, title, claims:[{ text, figures:[{value,unit,evidenceRef}] }] }] }
  evidenceRefs    Json // string[] — the de-duplicated audit trail of cited rows
  confidenceScore Float // 0–100 report-level confidence
  confidenceBasis Json // [{ key, weight, value }] — the score's own breakdown
  createdAt       DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("stakeholder_narratives")
}

// An approval gate on a plan/reallocation. Opt-in (Plan.requiresApproval): a
// strategist's plan can require a sign-off before a buyer executes it. Request
// + decision both write a CollaborationEvent — "all in the audit log."
model ApprovalRequest {
  id            String        @id @default(uuid()) @db.Uuid
  workspaceId   String        @db.Uuid
  planId        String?       @db.Uuid
  subjectType   String // e.g. "PLAN", "REALLOCATION"
  subjectId     String
  requestedById String        @db.Uuid
  state         ApprovalState @default(PENDING)
  decidedById   String?       @db.Uuid
  reason        String?
  createdAt     DateTime      @default(now())
  decidedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state])
  @@index([planId])
  @@map("approval_requests")
}

// The collaboration audit log — every approval, handoff, and narrative
// generation. Sibling to the execution-typed AuditLog (which is tied to
// ActionType/Meta); collaboration events don't fit that, so they live here.
model CollaborationEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  actorId     String?                @db.Uuid
  type        CollaborationEventType
  subjectType String
  subjectId   String
  fromRole    WorkspaceRole?
  toRole      WorkspaceRole?
  detail      Json?
  createdAt   DateTime               @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([subjectId])
  @@map("collaboration_events")
}

// ════════════════════════════════════════════════════════════
// PHASE 9 — AGENTIC OS (the nervous system: run the loop)
// ════════════════════════════════════════════════════════════

// One audit row per loop sweep — when Lumi ran the detect→propose pass, what
// it surfaced, and whether the loop is closed. The proposals themselves stay
// in their existing rows (Decision/TestExperiment/AllocationPlan); this is the
// thin audit, NOT a parallel proposal store. The monitoring fields (closed /
// loopHealth / staleStages) are lifted out of `stageStatus` JSON so queries
// like "show stalled loops" are an index scan, not a JSON dig.
model LoopRun {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  trigger     LoopTrigger
  startedAt   DateTime
  finishedAt  DateTime?

  proposalsByType Json // { VERDICT, REALLOCATION, TEST, PLAN_ADJUSTMENT, ... } counts
  stageStatus     Json // full per-stage detail [{ stage, state, lastAt, count }]
  summary         String
  aiInsight       String? // pre-generated portfolio briefing paragraph (1-2 sentences)

  // Queryable monitoring (lifted out of stageStatus JSON).
  closed      Boolean
  loopHealth  LoopHealth
  staleStages Json // the stale LOOP_STAGE keys, e.g. ["EXECUTE","LEARN"]

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, loopHealth])
  @@map("loop_runs")
}

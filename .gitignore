# Environment variables — NEVER commit these
.env
.env.local
.env.production

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build output
dist/
build/
# …except the committed React production build, which Render serves directly.
# We also try to rebuild it during deploy (see render.yaml buildCommand), but
# the committed copy is the deterministic fallback.
!client/dist/
!client/dist/**

# Test artifacts
coverage/

# Claude Code local settings (keep shared settings.json but not local overrides)
.claude/settings.local.json

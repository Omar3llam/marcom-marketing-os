# ============================================================
# MARCOM v4 — Environment Configuration
# Copy to .env — NEVER commit .env to version control
# ============================================================

# ── ANTHROPIC ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── AIRTABLE ─────────────────────────────────────────────────
AIRTABLE_API_KEY=patYourPersonalAccessTokenHere
AIRTABLE_BASE_ID=appYourBaseIdHere
AIRTABLE_TABLE_NAME=MARCOM_Sessions

# ── EMAIL ─────────────────────────────────────────────────────
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
NOTIFICATION_EMAIL=alerts@yourdomain.com

# ── SCRAPINGBEE ───────────────────────────────────────────────
SCRAPINGBEE_API_KEY=your-scrapingbee-key-here

# ── INTEGRATION HUB ───────────────────────────────────────────
# POST /api/export forwards to this URL server-to-server.
# Frontend never sees this value.
N8N_EXPORT_WEBHOOK=https://your-n8n.com/webhook/marcom-export

# ── SERVER ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
WEBHOOK_SECRET=your-random-secret-string

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── POSTGRESQL (Phase 2 — replaces Airtable in production) ───
# DATABASE_URL is also used by the cross-device chat-history feature
# (/api/history/{save,list,:sessionId}). The required `title` column and
# the (user_id, last_updated DESC) index are added idempotently at server
# startup — no manual migration is required for upgrading deployments.
DATABASE_URL=postgresql://user:password@localhost:5432/marcom

# ── DIRECT_URL (required for Prisma migrations on Neon pooler) ───
# Neon provides two connection strings:
#   - DATABASE_URL: pooled (faster, for app queries)
#   - DIRECT_URL: direct (required for migrations, advisory locks)
# If your DATABASE_URL contains "-pooler", you MUST set DIRECT_URL to the direct endpoint.
# Get it from: Neon Console → Connection Details → Direct connection
# Example: postgresql://user:password@ep-crimson-band-aql9o446.c-8.us-east-1.aws.neon.tech:5432/marcom
DIRECT_URL=postgresql://user:password@localhost:5432/marcom

# ── REDIS (session cache — optional in dev, required in prod) ─
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REDIS_URL=redis://localhost:6379

# ── PRISMA (Phase 1+: Temporal Brain — uses DATABASE_URL above) ─
# Run: npm run prisma:generate
# Run: npm run prisma:push          (dev — non-destructive sync)
# Run: npm run prisma:migrate       (prod — versioned migrations)

# ── BULLMQ (Phase 2 — async action engine) ────────────────────
# Re-uses REDIS_URL above. Worker concurrency per queue.
BULLMQ_CONCURRENCY=5
BULLMQ_PREFIX=lumi

# ── TEMPORAL OBSERVER (Phase 3 — periodic learning loop) ──────
# Cron expression — defaults to every 15 minutes.
OBSERVER_CRON=*/15 * * * *
# Hours of post-action observation before recording sustainability.
OBSERVER_IMPACT_WINDOW_HRS=24

# ── FIREBASE ADMIN SDK (required — auth now uses Firebase) ───
# The full JSON service account object, stringified.
# Get from: Firebase Console → Project Settings → Service Accounts
#   → Generate new private key (downloads a .json file)
# Set value to the entire contents of that JSON file as a single-line string.
# Example: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── ADMIN PANEL (UserRole.ADMIN grant path) ─────────────────
# Comma-separated allowlist of operator emails granted the system ADMIN role.
# ADMIN is NEVER self-serve — it is granted ONLY via this list, applied both at
# first sign-in (auto-provision) and at every subsequent login (an email added
# here later is upgraded on the user's next request). Leave empty to grant no one.
# Gates GET/POST/DELETE /api/admin/* (requireAdmin). Example:
#   ADMIN_EMAILS=omar@marcom.ai,ops@marcom.ai
ADMIN_EMAILS=

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── ARTIFACT STORAGE (PR #27) ────────────────────────────────
# Storage backend for AI-generated artifacts (hooks, captions, visual briefs)
# Options: 'local' (filesystem), 's3' (AWS S3)
ARTIFACT_STORAGE_ADAPTER=local

# Local adapter configuration (dev/test)
ARTIFACT_STORAGE_PATH=./artifacts

# S3 adapter configuration (production)
# ARTIFACT_STORAGE_BUCKET=marcom-artifacts
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── AI PROVIDER APIS (PR #25/26) ─────────────────────────────
# Required for AI-powered content generation
# ANTHROPIC_API_KEY is already set above in legacy section
OPENAI_API_KEY=sk-proj-your-key-here

# ── OPENAI MODEL CONFIGURATION (Content Quality) ─────────────
# CONTENT_MODEL: Used for hooks, copy, headlines (quality matters)
#   Options: gpt-4o (best quality), gpt-4o-mini (fastest)
# UTILITY_MODEL: Used for captions, visual prompts (speed matters)
# CONTENT_TEMPERATURE: Creativity level (0.0-1.0, higher = more creative)
#
# DEFAULT: gpt-4o for content (better quality), gpt-4o-mini for utility
# COST IMPACT: gpt-4o is 33x more expensive than gpt-4o-mini
#   Input: gpt-4o ($5/1M) vs gpt-4o-mini ($0.15/1M)
#   Output: gpt-4o ($15/1M) vs gpt-4o-mini ($0.60/1M)
#
# Recommendation for Marketing Content:
#   OPENAI_CONTENT_MODEL=gpt-4o (quality wins)
#   OPENAI_CONTENT_TEMPERATURE=0.9 (high creativity)
OPENAI_CONTENT_MODEL=gpt-4o
OPENAI_UTILITY_MODEL=gpt-4o-mini
OPENAI_CONTENT_TEMPERATURE=0.9

# ── INTELLIGENT PROVIDER ROUTING (PR #38/39/40) ──────────────
# Enable analytics-based provider selection
# PR #38: Query performance data and log recommendations
# PR #39: Actively route to best-performing provider with A/B testing
# PR #40: Cost-quality optimization
ENABLE_INTELLIGENT_ROUTING=false
ENABLE_ACTIVE_ROUTING=false
AB_TEST_CONTROL_PERCENTAGE=10

# PR #40: Cost optimization settings
# ENABLE_COST_OPTIMIZATION: Route based on cost-quality value score
# MAX_COST_PER_APPROVAL: Hard limit on cost per approved artifact (USD)
ENABLE_COST_OPTIMIZATION=false
MAX_COST_PER_APPROVAL=

# PR #41: Real performance optimization
# ENABLE_REAL_PERFORMANCE: Route based on actual CTR/CPC/ROAS from Meta
ENABLE_REAL_PERFORMANCE=false

# PR #42: Adaptive Reinforcement Engine
# ENABLE_REINFORCEMENT_LEARNING: Enable autonomous provider weight adjustments
# REINFORCEMENT_UPDATE_INTERVAL: How often to recalculate scores (milliseconds, default 24h)
# REINFORCEMENT_AUTO_APPLY: Automatically apply weight recommendations (default false)
ENABLE_REINFORCEMENT_LEARNING=false
REINFORCEMENT_UPDATE_INTERVAL=86400000
REINFORCEMENT_AUTO_APPLY=false
